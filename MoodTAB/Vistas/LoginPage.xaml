<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.LoginPage"
             NavigationPage.HasNavigationBar="False"             
             >
    <ScrollView BackgroundColor="#6493e5">
        <VerticalStackLayout VerticalOptions="Center" BackgroundColor="#6493e5" Padding="10" Spacing="60">
            <Image Source="moodtablogo_white.png"/>
            <Frame IsVisible="False">
                <Grid RowDefinitions="*,*">
                    <Label Grid.Row="0" Text="{Binding LogsMessage}"
                        TextColor="Blue"
                        FontSize="14"
                        HorizontalOptions="Center"
                        IsVisible="False"/>
                    <Label Grid.Row="2" Text="{Binding ErrorMessage}"
                        TextColor="Red" />
                </Grid>
            </Frame>
            <Frame VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                <Grid RowDefinitions="*,*,*,*,*,*">
                    <Label Grid.Row="0" Text="Iniciar Sesión" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Entry  Grid.Row="1" Placeholder="Nombre" Text="{Binding Nombre}" />
                    <Entry  Grid.Row="2" Placeholder="Email" Text="{Binding Email}" />
                    <HorizontalStackLayout  Grid.Row="3">
                        <CheckBox IsChecked="{Binding EsFamiliar}" />
                        <Label Text="Soy familiar/tutor" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Button  Grid.Row="4" 
                        Text="Ingresar"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#eeeeee"
                        TextColor="Black" />
                    <Label Grid.Row="5" Text="{Binding ErrorMessage}"
                        TextColor="Red" />
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

