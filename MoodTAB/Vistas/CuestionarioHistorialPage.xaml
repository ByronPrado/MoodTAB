<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MoodTAB.Converters"
             x:Class="MoodTAB.Vistas.CuestionarioHistorialPage"
             Title="Historial Cuestionarios">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

   <ScrollView>
        <VerticalStackLayout>
                    <!-- Título -->
            <Label Text="Formularios Completados"
                FontFamily="BreeSerif-Regular.ttf"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
            <!-- Si no hay resultados -->
            <Label Text="{Binding Log}"
                TextColor="Gray"
                FontFamily="BreeSerif-Regular.ttf"
                FontAttributes="Italic"
                IsVisible="{Binding Log, Converter={StaticResource StringNotEmptyConverter}}"
                HorizontalOptions="Center" />

            <!-- Lista de cuestionarios -->
            <CollectionView x:Name="CuestionariosList"
                            ItemsSource="{Binding CuestionariosCompletados}"
                            SelectionMode="Single"
                            SelectionChanged="CollectionView_SelectionChanged">

                <CollectionView.EmptyView>
                    <StackLayout Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="No hay cuestionarios completados aún."
                            FontFamily="BreeSerif-Regular.ttf"
                            TextColor="Gray"
                            FontAttributes="Italic" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" Margin="5,3"
                            BorderColor="#DDD"
                            CornerRadius="12"
                            HasShadow="True"
                            IsClippedToBounds="False"
                            InputTransparent="True">
                            <VerticalStackLayout>
                                <Label Text="{Binding Formulario.Titulo}" 
                                    FontFamily="BreeSerif-Regular.ttf"
                                    FontSize="20" 
                                    FontAttributes="Bold"
                                    TextColor="#512BD4" />

                                <Label Text="{Binding Fecha_Asignacion, StringFormat='Asignado el {0:dd/MM/yy}'}"
                                    FontFamily="BreeSerif-Regular.ttf"
                                    FontSize="12" 
                                    TextColor="Gray" />
                            </VerticalStackLayout>                             
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
   </ScrollView>
</ContentPage>