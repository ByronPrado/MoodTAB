<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.UsuarioExternoPage"
             Title="UsuarioExternoPage">
    <ScrollView>
        <VerticalStackLayout>
            <Label 
                Text="Bienvenido {nombre}"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <Label
                Text = "Agrega un Comentario"
                VerticalOptions="Center"
                HorizontalOptions ="Center"
                />
            
            <Entry
                Placeholder ="Escrie tu comentario"
                Text ="{Binding ComentarioExterno}"
                VerticalOptions ="Center"
                HorizontalOptions="Center" 
                />

            <Label
                Text ="{Binding Ide}"
                TextColor ="Blue"
                />
            <Label
                Text="{Binding Log_txt}"
                TextColor="Red"
                VerticalOptions="Center" 
                HorizontalOptions="Center"

                />
            
            <Picker
                Title="Escoge un cuestionario"
                ItemsSource ="{Binding ListaCuestionarios}"
                />
            <Button 
                Text="Enviar comentario"
                Command="{Binding EnviarComentarioCommand}"/>
            <Button Text="🚪 Cerrar Sesión"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#6B7280"
                CornerRadius="25"
                HeightRequest="50"
                Clicked="OnLogoutClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>