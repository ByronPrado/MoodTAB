<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.UsuarioExternoPage"
             IconImageSource="appicon.png">
    <ScrollView>
            <VerticalStackLayout Padding="20,20,20,90" Spacing="15">

                <!-- Frame con título de la API -->
                <Image Source="moodtablogo.png"/>
                <Frame CornerRadius="12"
                       Padding="15"
                       BackgroundColor="#FFFCFCFC"
                       BorderColor="#0C000000">
                    <Grid
                        ColumnSpacing="0"
                        RowSpacing="10"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        RowDefinitions="Auto,Auto,auto">
                        <Label Text="Bienvenido"
                               Grid.Row="0"
                               FontSize="20"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontAttributes="Bold"
                               TextColor="#FF141414"/>
                        <Label Text="Deseas realizar un comentario?"
                               FontSize="14"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#FF9B9B9B"
                               Grid.Row="1"/>
                        <Label Text="{Binding Log_txt}"
                               Grid.Row="2"/>
                    </Grid>
                </Frame>

            <VerticalStackLayout Spacing="5">
            <Frame
                BackgroundColor="#FFD6E8FF"
                CornerRadius="15"
                Padding="10"
                BorderColor="#FFC7DFFF"
                HasShadow="False">
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="✏️ Ingrese su comentario" 
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        TextColor="#0F172A"/>
                    <Editor 
                        HeightRequest="100"
                        BackgroundColor="White"
                        TextColor="Black"
                        Text="{Binding ComentarioExterno}" />
                    <Button 
                        Text="🗣️ Dictar Diario"
                        Command="{Binding DictarDiarioCommand}" />
                    <Button Text="💾 Guardar Comentario"
                        FontSize="16"
                        FontFamily="BreeSerif-Regular.ttf"
                        HorizontalOptions="Center"
                        HeightRequest="50"
                        Command="{Binding EnviarComentarioCommand}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3B82F6" Offset="0.0" />
                            <GradientStop Color="#10B981" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                </VerticalStackLayout>
            </Frame>
            </VerticalStackLayout>

              <VerticalStackLayout Spacing="5">
            <Frame
                BackgroundColor="#FFD6E8FF"
                CornerRadius="15"
                Padding="10"
                BorderColor="#FFC7DFFF"
                HasShadow="False">
                <VerticalStackLayout Spacing="5">
            <Label
                Text ="{Binding Ide}"
                TextColor ="Blue"
                />
            <Label
                Text="{Binding Log_txt}"
                TextColor="Red"
                VerticalOptions="Center" 
                HorizontalOptions="Center"
                />            
            <Picker
                Title="Escoge un cuestionario"
                ItemsSource ="{Binding ListaCuestionarios}"
                IsVisible="False"
                IsEnabled ="False"
                />
                </VerticalStackLayout>
            </Frame>
            </VerticalStackLayout>
            <Entry Text ="{Binding Log_txt}"/>
            <Button Text="🚪 Cerrar Sesión"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#6B7280"
                CornerRadius="25"
                HeightRequest="50"
                Clicked="OnLogoutClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>