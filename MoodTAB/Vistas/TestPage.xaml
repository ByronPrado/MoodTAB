<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.TestPage"
             Title="Ajustes"
             BackgroundColor="#F8F9FA">
       <NavigationPage.TitleView>
        <Grid>
            <Label Text="Ajustes"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="20"
                   Padding="-66,0,0,0"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView VerticalScrollBarVisibility="Always"> 
        <VerticalStackLayout Spacing="5" Padding="16,20">
            
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="0"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="0">
                    
                    <VerticalStackLayout Spacing="4" Margin="16,16,16,12">
                        <Label Text="Soporte SmarthWatch"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               TextTransform="Uppercase"/>
                        <Label Text="En caso de no poseer un smarthwach activar la siguiente opción" 
                               FontSize="13"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>
                    
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="#EEF2FF"
                               CornerRadius="10"
                               Padding="0"
                               HasShadow="False"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center">
                            <Label Text="✍️" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2" 
                                           Margin="12,0,0,0"
                                           VerticalOptions="Center">
                            <Label Text="Ingreso de datos manual"
                                   FontFamily="BreeSerif-Regular.ttf"
                                   FontSize="16"
                                   TextColor="#1A1A1A"/>

                        </VerticalStackLayout>
                        
                        <Switch Grid.Column="2" 
                                IsToggled="{Binding HealthDataManual}"
                                VerticalOptions="Center"/>
                    </Grid>
                    
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="0"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="0">
                    
                    <VerticalStackLayout Spacing="4" Margin="16,16,16,12">
                        <Label Text="Toma de datos"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               TextTransform="Uppercase"/>
                        <Label Text="Datos que se ingresaran en los diarios emocionales" 
                               FontSize="13"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>
                    
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="#FEE2E2"
                               CornerRadius="10"
                               Padding="0"
                               HasShadow="False"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center">
                            <Label Text="❤️" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                        <Label Grid.Column="1" 
                               Text="Frecuencia cardíaca"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontSize="16"
                               TextColor="#1A1A1A"
                               VerticalOptions="Center"
                               Margin="12,0,0,0"/>
                        
                        <Switch Grid.Column="2" 
                                IsToggled="{Binding OptionHR}"
                                VerticalOptions="Center"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>
                    
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="#DBEAFE"
                               CornerRadius="10"
                               Padding="0"
                               HasShadow="False"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center">
                            <Label Text="📊" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2" 
                                           Margin="12,0,0,0"
                                           VerticalOptions="Center">
                            <Label Text="Variabilidad de la Frecuencia cardíaca"
                                   FontFamily="BreeSerif-Regular.ttf"
                                   FontSize="16"
                                   TextColor="#1A1A1A"/>

                        </VerticalStackLayout>
                        
                        <Switch Grid.Column="2" 
                                IsToggled="{Binding OptionHRV}"
                                VerticalOptions="Center"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>
                    
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="#D1FAE5"
                               CornerRadius="10"
                               Padding="0"
                               HasShadow="False"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center">
                            <Label Text="👟" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                        <Label Grid.Column="1" 
                               Text="Pasos"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontSize="16"
                               TextColor="#1A1A1A"
                               VerticalOptions="Center"
                               Margin="12,0,0,0"/>
                        
                        <Switch Grid.Column="2"
                                IsToggled="{Binding OptionPasos}"
                                VerticalOptions="Center"/>
                    </Grid>
                    
                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>
                    
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="0"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="0">
                    
                    <VerticalStackLayout Spacing="4" Margin="16,16,16,12">
                        <Label Text="Formato ingreso del sueño"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               TextTransform="Uppercase"/>
                        <Label Text="Alternar el formato de ingreso de sueño" 
                               FontSize="13"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>

                    
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="#FEF3C7"
                               CornerRadius="10"
                               Padding="0"
                               HasShadow="False"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center">
                            <Label Text="🌙" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2" 
                                           Margin="12,0,0,0"
                                           VerticalOptions="Center">
                            <Label Text="{Binding OpcionSuenoTexto}"
                                   FontFamily="BreeSerif-Regular.ttf"
                                   FontSize="14"
                                   TextColor="#1A1A1A"/>
                            <Label Text="{Binding OpcionSuenoTexto2}"
                                   FontFamily="BreeSerif-Regular.ttf"
                                   FontSize="14"
                                   TextColor="#1A1A1A"/>

                        </VerticalStackLayout>
                        
                        <Switch Grid.Column="2" 
                                IsToggled="{Binding OptionSueno}"/>
                    </Grid>
                    
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="0"
                   Margin="0,0,0,12">
                <VerticalStackLayout Spacing="0">
                    
                    <VerticalStackLayout Spacing="4" Margin="16,16,16,12">
                        <Label Text="Personalización"
                               FontFamily="BreeSerif-Regular.ttf"
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#1A1A1A"
                               TextTransform="Uppercase"/>
                        <Label Text="Opciones de personalización de la interfaz" 
                               FontSize="13"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" 
                             Margin="16,0"/>
                    
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Frame Grid.Column="0"
                               BackgroundColor="#DCB2D3FF"
                               CornerRadius="10"
                               Padding="0"
                               HasShadow="False"
                               WidthRequest="40"
                               HeightRequest="40"
                               VerticalOptions="Center">
                            <Label Text="📜" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                        <VerticalStackLayout Grid.Column="1" 
                                           Spacing="2" 
                                           Margin="12,0,0,0"
                                           VerticalOptions="Center">
                            <Label Text="Mostrar Consejos" 
                                   FontSize="16"
                                   FontFamily="BreeSerif-Regular.ttf"
                                   TextColor="#1A1A1A"/>
                        </VerticalStackLayout>
                        
                        <Switch Grid.Column="2" 
                                IsToggled="{Binding OpcionMostrarConsejos}"
                                VerticalOptions="Center"/>
                    </Grid>
                    
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
