<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MoodTAB.Converters"
             x:Class="MoodTAB.Vistas.DiarioPage"
            >

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <NavigationPage.TitleView>
        <Grid>
            <Label Text="    💙 Nuevo Diario"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView BackgroundColor="#FFF3F3FF">
        <VerticalStackLayout  Spacing="15" Margin="5">
            
            <!-- Titulo -->
            <Frame Padding="15" CornerRadius="20" BackgroundColor="#E8F0FE" BorderColor="#00F0F8FF">
                <Frame.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#DBEAFE" Offset="0.0" />
                        <GradientStop Color="#DCFCE8" Offset="1.0" />
                    </LinearGradientBrush>
                </Frame.Background>
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">

                    <Label Text="Desliza para seleccionar como estuvo tu día" 
                           FontFamily="BreeSerif-Regular.ttf" 
                           FontSize="12" 
                           TextColor="#FF1B1B1B"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Sliders -->
            <VerticalStackLayout Padding="10,0" Spacing="8">
                <!-- Animo -->
                <Label Text="Mi estado de ánimo"
                    FontFamily="BreeSerif-Regular.ttf"
                    FontSize="14"
                    TextColor="#333"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="40,*,40" RowDefinitions="auto,auto" VerticalOptions="Center">
                    <Label Text="😢" FontSize="20" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Triste" FontSize="12" TextColor="#FF646464" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center" />

                    <Slider Grid.Column="1"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="10"
                            WidthRequest="200"
                            ThumbColor="#4285F4"
                            MinimumTrackColor="#4285F4"
                            MaximumTrackColor="#FFB2B4B7"
                            Value="{Binding Animo, Mode=TwoWay}"
                            />

                    <Label Text=" 😄 " FontSize="20" Grid.Column="2" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text=" Feliz" FontSize="12" TextColor="#FF646464" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" />
                </Grid>

                <!-- Apetito -->
                <Label Text="Mi apetito"
                    FontFamily="BreeSerif-Regular.ttf"
                    FontSize="14"
                    TextColor="#333"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="40,*,40" RowDefinitions="auto,auto" VerticalOptions="Center">
                    <Label Text="🫤" FontSize="20" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Nada" FontSize="12" TextColor="#FF646464" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center"/>

                    <Slider Grid.Column="1"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="10"
                            WidthRequest="200"
                            ThumbColor="#4285F4"
                            MinimumTrackColor="#4285F4"
                            MaximumTrackColor="#FFB2B4B7"
                            Value="{Binding Apetito, Mode=TwoWay}"
                            />

                    <Label Text="😋" FontSize="20" Grid.Column="2" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Mucho" FontSize="12" TextColor="#FF646464" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" />
                </Grid>

                <!-- Energía -->
                <Label Text="Mi Energía"
                    FontFamily="BreeSerif-Regular.ttf"
                    FontSize="14"
                    TextColor="#333"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="40,*,40" RowDefinitions="auto,auto" VerticalOptions="Center">
                    <Label Text="😪" FontSize="20" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Nada" FontSize="12" TextColor="#FF646464" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center"/>

                    <Slider Grid.Column="1"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="10"
                            WidthRequest="200"
                            ThumbColor="#4285F4"
                            MinimumTrackColor="#4285F4"
                            MaximumTrackColor="#FFB2B4B7"
                            Value="{Binding Energia, Mode=TwoWay}"
                            />

                    <Label Text="😃" FontSize="20" Grid.Column="2" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Mucha" FontSize="12" TextColor="#FF646464" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" />
                </Grid>

                <!-- Batería Social -->
                <Label Text="Mi batería social"
                    FontFamily="BreeSerif-Regular.ttf"
                    FontSize="14"
                    TextColor="#333"
                    HorizontalOptions="Center" />
                <Grid ColumnDefinitions="40,*,40" RowDefinitions="auto,auto" VerticalOptions="Center">
                    <Label Text="😪" FontSize="20" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Nada" FontSize="12" TextColor="#FF646464" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center"/>

                    <Slider Grid.Column="1"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="10"
                            WidthRequest="200"
                            ThumbColor="#4285F4"
                            MinimumTrackColor="#4285F4"
                            MaximumTrackColor="#FFB2B4B7"
                            Value="{Binding BateriaSocial, Mode=TwoWay}"
                            />

                    <Label Text="😃" FontSize="20" Grid.Column="2" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <Label Text="Mucha" FontSize="12" TextColor="#FF646464" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" />
                </Grid>

            </VerticalStackLayout>

            <!-- Preguntas de rutina -->
            <VerticalStackLayout Spacing="5">
            <Frame
                BackgroundColor="#FFD6E8FF"
                CornerRadius="15"
                Padding="10"
                BorderColor="#FFD6E8FF"
                HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label 
                            Text="💭 Mis reflexiones del día" 
                            FontSize="16"
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            TextColor="#0F172A"
                            HorizontalOptions="Center"/>
                    <Label 
                        Text="¿Cómo han estado tus pensamientos?" 
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        TextColor="#0F172A"/>
                    <Editor 
                        HeightRequest="75"
                        BackgroundColor="White"
                        TextColor="Black"
                        Margin="0,0,0,8"
                        Text="{Binding Pregunta1}" />
                    <Button
                        Text="Dictar por voz"
                        Command="{Binding DictarDiario1Command}"
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        HorizontalOptions="Center"
                        HeightRequest="30"
                        Padding="10,0"/>
                        <Label Text=" " HeightRequest="8"
                               FontAttributes="Bold"/>
                    <Label 
                        Text="¿Algo que consideres importante de tu día?" 
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        TextColor="#0F172A"/>
                    <Editor 
                        HeightRequest="75"
                        BackgroundColor="White"
                        TextColor="Black"
                        Margin="0,0,0,8"
                        Text="{Binding Pregunta2}" />
                    <Button
                        Text="Dictar por voz"
                        Command="{Binding DictarDiario2Command}"
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        HorizontalOptions="Center"
                        HeightRequest="30"
                        Padding="10,0"/>
                    <Label Text=" " HeightRequest="8"
                               FontAttributes="Bold"/>
                    <Label 
                        Text="¿Algo más que quieras contar?" 
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        TextColor="#0F172A"/>
                    <Editor 
                        HeightRequest="75"
                        BackgroundColor="White"
                        TextColor="Black"
                        Margin="0,0,0,8"
                        Text="{Binding Pregunta3}" />
                    <Button
                        Text="Dictar por voz"
                        Command="{Binding DictarDiario3Command}"
                        FontSize="14"
                        FontFamily="BreeSerif-Regular.ttf"
                        HorizontalOptions="Center"
                        HeightRequest="30"
                        Padding="10,0"/>
                    <Label Text=" " HeightRequest="8"
                               FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>
            </VerticalStackLayout>
            
            <!-- Actividad diaria -->
            <VerticalStackLayout Spacing="10">
                <Label Text="📈 Actividad del día" 
                       FontFamily="BreeSerif-Regular.ttf" 
                       FontAttributes="Bold" 
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="#0F172A"
                       IsVisible="{Binding ActividadDiaria}"/>

                <!-- Ritmo Cardiaco -->
                <Frame CornerRadius="15" 
                       Padding="10"
                       HasShadow="True"
                       BackgroundColor="#FFCEDEFF"
                       BorderColor="#FFCEDEFF" 
                       IsVisible="{Binding OptionHR}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="❤️ Ritmo Cardiaco (BPM)" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16" 
                               TextColor="#FF1C31B9"/>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Entry x:Name="EntryHR"
                                Text="{Binding RitmoCardiaco}" 
                                   IsEnabled="{Binding HealthDataManual}" 
                                   Keyboard="Numeric" 
                                   FontFamily="BreeSerif-Regular.ttf" 
                                   FontSize="16" 
                                   WidthRequest="200"
                                   FontAttributes="Bold" 
                                   TextColor="#FF1C31B9"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Variabilidad de la Frecuencia Cardiaca -->
                <Frame CornerRadius="15" 
                       Padding="10" 
                       BackgroundColor="#E0E7FF" 
                       BorderColor="#E0E7FF"
                       HasShadow="True"
                       IsVisible="{Binding OptionHRV}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="💓 Variabilidad Frecuencia Cardiaca (ms)" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16" 
                               TextColor="#3730A3"/>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Entry x:Name="EntryHRV" 
                                Text="{Binding VariabilidadFrecuenciaCardiaca}" 
                                   IsEnabled="{Binding HealthDataManual}" 
                                   Keyboard="Numeric" 
                                   FontFamily="BreeSerif-Regular.ttf" 
                                   FontSize="16" 
                                   WidthRequest="200" 
                                   FontAttributes="Bold" 
                                   TextColor="#3730A3"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Pasos -->
                <Frame CornerRadius="15" 
                       Padding="10" 
                       BackgroundColor="#DCFCE7" 
                       BorderColor="#DCFCE7"
                       HasShadow="True"
                       IsVisible="{Binding OptionPasos}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🚶 Cantidad de Pasos" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16" 
                               TextColor="#166534"/>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Entry x:Name="EntryPasos"
                                Text="{Binding CantidadPasos}" 
                                   IsEnabled="{Binding HealthDataManual}" 
                                   Keyboard="Numeric" 
                                   FontFamily="BreeSerif-Regular.ttf" 
                                   FontSize="16" 
                                   WidthRequest="200"
                                   FontAttributes="Bold" 
                                   TextColor="#166534"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>



                <Label Text="💤 Sueño" 
                       FontFamily="BreeSerif-Regular.ttf" 
                       FontAttributes="Bold" 
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="#0F172A"/>
                <!-- Cantidad de horas de sueño -->
                <Frame CornerRadius="15"
                       Padding="10" 
                       BackgroundColor="#FFD5EDFF"
                       HasShadow="True"
                       BorderColor="#FFD5EDFF">
                    <VerticalStackLayout Spacing="5">
                        <!-- Calidad de sueño -->
                        <Label Text="¿Cómo dormiste hoy?"
                            FontAttributes="Bold" 
                            FontFamily="BreeSerif-Regular.ttf" 
                            FontSize="16"
                            TextColor="#FF1A4E75"
                            HorizontalOptions="Center" />
                        <Grid ColumnDefinitions="40,*,40" RowDefinitions="auto,auto" VerticalOptions="Center">
                            <Label Text="😣" FontSize="20" Grid.Column="0" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="Mal" FontSize="12" TextColor="#FF1A4E75" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center"/>

                            <Slider Grid.Column="1"
                                    Grid.Row="0"
                                    Minimum="0"
                                    Maximum="10"
                                    ThumbColor="#4285F4"
                                    MinimumTrackColor="#4285F4"
                                    MaximumTrackColor="#FFB2B4B7"
                                    Value="{Binding CalidadSueno, Mode=TwoWay}"/>

                            <Label Text="😴" FontSize="20" Grid.Column="2" Grid.Row="0" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="Bien" FontSize="12" TextColor="#FF1A4E75" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" />
                        </Grid>

                        <Label Text="¿Cuantas Horas dormiste?" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"
                               IsVisible="{Binding OptionSuenoTrue}"
                               TextColor="#FF1A4E75"/>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center" IsVisible="{Binding OptionSuenoTrue}">
                            <Entry x:Name="EntryHorasSueno"
                                Text="{Binding HorasSueno}" 
                                   IsEnabled="{Binding HealthDataManual}" 
                                   Keyboard="Numeric" 
                                   FontFamily="BreeSerif-Regular.ttf" 
                                   FontSize="16"
                                   FontAttributes="Bold" 
                                   TextColor="#FF1A4E75"/>
                            <Label Text="hrs" 
                                   FontFamily="BreeSerif-Regular.ttf" 
                                   FontSize="16" 
                                   WidthRequest="200"
                                   FontAttributes="Bold" 
                                   Padding="-10,10,0,0"
                                   TextColor="#FF1A4E75"/>
                        </HorizontalStackLayout>
                        <Label Text="🌙 Hora en que se durmió" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"
                               IsVisible="{Binding OptionSuenoFalse}"
                               TextColor="#0C4A6E"/>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center" IsVisible="{Binding OptionSuenoFalse}">
                            <TimePicker Time="{Binding HoraDurmio}" 
                                        IsEnabled="{Binding HealthDataManual}" 
                                        FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"
                                        TextColor="#0C4A6E"/>
                        </HorizontalStackLayout>
                        <Label Text="☀️ Hora en que despertó" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"
                               IsVisible="{Binding OptionSuenoFalse}"
                               TextColor="#0C4A6E"/>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center" IsVisible="{Binding OptionSuenoFalse}">
                            <TimePicker Time="{Binding HoraDesperto}" 
                                        IsEnabled="{Binding HealthDataManual}" 
                                        FontFamily="BreeSerif-Regular.ttf" 
                                        FontSize="16" 
                                        TextColor="#0C4A6E"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="📱 Uso del celular" 
                       FontFamily="BreeSerif-Regular.ttf" 
                       FontAttributes="Bold" 
                       FontSize="16"
                       HorizontalTextAlignment="Center"
                       TextColor="#0F172A"/>
                <!-- Uso del celular -->
                <Frame CornerRadius="15" 
                       Padding="10"
                       HasShadow="True"
                       BackgroundColor="#DBEAFE" 
                       BorderColor="#DBEAFE">
                    <VerticalStackLayout>
                        <Label Text="🕑 Horas totales" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"  
                               TextColor="#1E3A8A"/>

                        <Label Text="{Binding HorasCelular, StringFormat='{0:F1} hrs'}" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#1E3A8A"/>
                        <Label Text=" " 
                               FontAttributes="Bold"/>
                        <Label Text="🛜 Horas en redes sociales" 
                               FontAttributes="Bold" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"
                               TextColor="#1E3A8A"/>
                        <Label Text="{Binding HorasRedes, StringFormat='{0:F1} hrs'}" 
                               FontFamily="BreeSerif-Regular.ttf" 
                               FontSize="16"  
                               FontAttributes="Bold" 
                               TextColor="#1E3A8A"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <Button Text="💾 Guardar registro del día"
                    FontSize="16"
                    FontFamily="BreeSerif-Regular.ttf"
                    HorizontalOptions="Center"
                    HeightRequest="50"
                    Command="{Binding GuardarDiarioCommand}">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0.0" />
                        <GradientStop Color="#10B981" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button Text="Borrar BD"
                    HeightRequest="50" 
                    FontSize="16" 
                    HorizontalOptions="Center" 
                    Background="red" 
                    Command="{Binding BorrarDiarioCommand}"
                    IsVisible="False"/>
            <Label
                x:Name="StatusLabel"
                Text="Presiona el botón para cargar datos"
                FontSize="12"
                IsVisible="False"
                TextColor="#7F8C8D"
                HorizontalOptions="Center"
                Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
