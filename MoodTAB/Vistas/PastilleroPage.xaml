<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:local="clr-namespace:MoodTAB.ViewModel"
             x:Class="MoodTAB.Vistas.PastilleroPage"
             Title="Pastillero">

    <ContentPage.BindingContext>
        <local:PastilleroViewModel/>
    </ContentPage.BindingContext>
    
    <NavigationPage.TitleView>
        <Grid >
            <Label Text="    💊 Medicamentos"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>

    <Grid BackgroundColor="#FFF3F3FF">
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="15">

                
                    <Frame BackgroundColor="White"
                            CornerRadius="16"
                            HasShadow="True"
                            Padding="15"
                            Margin="0,0,0,0">
                    <controls:Calendar
                        x:Name="MiCalendario"
                        CalendarLayout="Month"
                        Culture="{Binding Cultura}"
                        Events="{Binding Events}"
                        DayTappedCommand="{Binding DiaTocadoCommand}"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        FirstDayOfWeek="Monday"
                        EventIndicatorColor="#3B82F6"
                        EventIndicatorSelectedColor="White"
                        DeselectedDayTextColor="Black"
                        SelectedDayTextColor="White"
                        SelectedDayBackgroundColor="#3B82F6"
                        SwipeUpToHideEnabled="True"

                        TodayOutlineColor="#10B981"
                        TodayFillColor="#D1FAE5"
                        OtherMonthDayColor="LightGray"
                        EventIndicatorType="BottomDot"

                        ShowYearPicker ="False"
                        ArrowsColor ="White"
                        ArrowsSymbolNext =">"
                        ArrowsSymbolPrev ="&lt;"
                        ArrowsBackgroundColor="#3B82F6"
                        />
                    </Frame>

                <!-- 💊 FORMULARIO DE REGISTRO -->
                <Frame BackgroundColor="White"
                            CornerRadius="16"
                            x:Name="FrameRegistro"
                            HasShadow="True"
                            Padding="15"
                            Margin="0,0,0,0">
                    <VerticalStackLayout>
                        <Label Text="Registrar Medicamento Hoy" FontAttributes="Bold" FontFamily="BreeSerif-Regular.ttf" FontSize="18" HorizontalOptions="Center"/>
                        <Entry Placeholder="Nombre" FontFamily="BreeSerif-Regular.ttf" Text="{Binding NombreMed}"/>
                        <Entry Placeholder="Dosis" FontFamily="BreeSerif-Regular.ttf" Text="{Binding DosisMed}"/>
                        <Button Text="💾 Guardar"
                                FontFamily="BreeSerif-Regular.ttf"
                                Command="{Binding RegistrarMedicamentoCommand}"
                                BackgroundColor="#3B82F6" TextColor="White"
                                CornerRadius="10"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- 📋 LISTA DE MEDICAMENTOS DEL DÍA -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="15"
                        IsVisible="{Binding MedVisible}"
                        Margin="0,0,0,0">
                    <VerticalStackLayout>
                        <Label Text="Medicamentos del día" FontAttributes="Bold" FontSize="18" FontFamily="BreeSerif-Regular.ttf" HorizontalOptions="Center"/>
                        <CollectionView ItemsSource="{Binding MedicamentosDiaSeleccionado}">
                            <CollectionView.EmptyView>
                                <StackLayout Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="No hay medicamentos registraods"
                                        FontFamily="BreeSerif-Regular.ttf"
                                        TextColor="#FF898989"
                                        FontAttributes="Italic" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BorderColor="#E0E0E0" Padding="5" CornerRadius="10">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontFamily="BreeSerif-Regular.ttf"/>
                                            <Label Text="{Binding Dosis}" FontSize="12" FontFamily="BreeSerif-Regular.ttf"/> 
                                            <Label Text="{Binding CreatedAt, StringFormat= a las {0:hh:mm}}" FontSize="12" TextColor="Gray" FontFamily="BreeSerif-Regular.ttf"/>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
