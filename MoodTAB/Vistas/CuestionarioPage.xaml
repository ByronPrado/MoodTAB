<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.CuestionarioPage"
            >

    <NavigationPage.TitleView>
        <Grid>
            <Label Text="   📝 Cuestionarios"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView BackgroundColor="#FFF3F3FF">
        <VerticalStackLayout Padding="5" Spacing="15">
            <Entry Text="{Binding Log_test}"
                IsVisible ="False"/>

            <Label Text="Selecciona un Cuestionario:" FontAttributes="Bold" FontSize="18" />
            <CollectionView ItemsSource="{Binding ListaCuestionarios}"
                SelectionMode="Single"
                SelectionChanged="CollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15" Margin="5" CornerRadius="15" BackgroundColor="#E8F0FE" IsClippedToBounds="False" InputTransparent="True">
                            <VerticalStackLayout>
                                <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="{Binding PreguntasConRespuesta.Count, StringFormat='Preguntas: {0}'}" FontSize="14" TextColor="#333"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <Label Text="No hay cuestionario disponibles."
                FontSize="16"
                TextColor="Gray"
                HorizontalOptions="Center"
                IsVisible="{Binding Nopendiente}"/>
                
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
