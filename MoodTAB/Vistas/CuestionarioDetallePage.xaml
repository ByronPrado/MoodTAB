<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MoodTAB.Vistas.CuestionarioDetallePage"
    Title="Cuestionario"
    BackgroundColor="#FAFAFA">
    
    <NavigationPage.TitleView>
        <Grid>
            <Label Text="Cuestionario"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="20"
                   Padding="-66,0,0,0"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#202124"/>
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView VerticalScrollBarVisibility="Always">                
        <VerticalStackLayout Padding="20,16" Spacing="0">

            <CollectionView x:Name="PreguntasColl"
                ItemsSource="{Binding PreguntasPaginadas}"
                Margin="0,0,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        
                        <Frame BackgroundColor="White"
                            CornerRadius="16"
                            HasShadow="True"
                            Padding="10"
                            Margin="0,0,0,12">
                
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding Pregunta.Contenido}" 
                                    FontAttributes="Bold" 
                                    FontSize="16"
                                    FontFamily="BreeSerif-Regular.ttf"
                                    TextColor="#202124"
                                    LineBreakMode="WordWrap" />  

                                <!-- Pregunta abierta -->
                                <Frame IsVisible="{Binding EsAbierta}"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    Padding="0"
                                    Margin="0">
                                    <Editor
                                        Placeholder="Escribe tu respuesta aquí..."
                                        PlaceholderColor="#9AA0A6"
                                        HeightRequest="100"
                                        BackgroundColor="#F8F9FA"
                                        TextColor="#202124"
                                        FontFamily="BreeSerif-Regular.ttf"
                                        Text="{Binding RespuestaUsuario, Mode=TwoWay}"
                                        AutoSize="TextChanges"/>                                
                                </Frame>

                                <!-- Pregunta escala -->
                                <Frame IsVisible="{Binding EsEscala}"
                                    BackgroundColor="#00000000"
                                    BorderColor="Transparent"
                                    Padding="10"
                                    Margin="0">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding RespuestaUsuarioEscala, StringFormat='Respuesta: {0}'}" 
                                            FontSize="12" 
                                            TextColor="#5F6368"
                                            FontFamily="BreeSerif-Regular.ttf"
                                            FontAttributes="Bold"/>
                                        <Slider Minimum="{Binding MinimoEscala}" 
                                            Maximum="{Binding MaximoEscala}"                                            
                                            Value="{Binding RespuestaUsuarioEscala, Mode=TwoWay}"
                                            ThumbColor="#4285F4"
                                            MinimumTrackColor="#4285F4"
                                            MaximumTrackColor="#FFB2B4B7" />
                                       
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                                            <Label Grid.Column="0"
                                                Text="{Binding MinimoEscala, StringFormat='{0}'}"
                                                FontSize="11"
                                                FontFamily="BreeSerif-Regular.ttf"
                                                TextColor="#9AA0A6" />
                                            <Label Grid.Column="1"
                                                Text="{Binding MaximoEscala, StringFormat='{0}'}"
                                                FontSize="11"
                                                FontFamily="BreeSerif-Regular.ttf"
                                                TextColor="#9AA0A6"
                                                HorizontalOptions="End" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>

                                <!-- Pregunta Selección -->
                                <Frame IsVisible="{Binding EsSeleccion}"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    Padding="0"
                                    InputTransparent="False"
                                    Margin="0">
                                    <VerticalStackLayout Spacing="8">
                                        <CollectionView ItemsSource="{Binding OpcionesSeleccion}" 
                                            SelectionMode="None">
                                            <CollectionView.ItemsLayout>
                                                <GridItemsLayout Orientation="Vertical" Span="1"/>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Frame Padding="0"
                                                        Margin="0,0,0,10"
                                                        CornerRadius="4"
                                                        BorderColor="White"
                                                        BackgroundColor="White"
                                                        InputTransparent="False"
                                                        HasShadow="False">
                                                        
                                                        <Grid ColumnDefinitions="28,*" 
                                                            ColumnSpacing="12"
                                                            Padding="12">
                                                            
                                                            <Frame Grid.Column="0"
                                                                Padding="0"
                                                                CornerRadius="14"
                                                                BorderColor="#FF838383"
                                                                BackgroundColor="White"
                                                                HasShadow="False"
                                                                InputTransparent="False"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                VerticalOptions="Center">
                                                                <Frame.GestureRecognizers>
                                                                    <TapGestureRecognizer 
                                                                    Command="{Binding BindingContext.SeleccionarOpcionCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                                                    CommandParameter="{Binding Texto}"
                                                                    NumberOfTapsRequired="1"
                                                                   
                                                                    />
                                                                </Frame.GestureRecognizers>    
                                                                
                                                                <Frame CornerRadius="10"
                                                                    Padding="0"
                                                                    BackgroundColor="#FF567ED3"
                                                                    HasShadow="False"
                                                                    IsVisible="{Binding IsSelected}"
                                                                    Margin="2">
                                                                    <Frame.GestureRecognizers>
                                                                        <TapGestureRecognizer 
                                                                            Command="{Binding BindingContext.SeleccionarOpcionCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                                                            CommandParameter="{Binding Texto}"
                                                                            NumberOfTapsRequired="1"
                                                                           />
                                                                    </Frame.GestureRecognizers>    
                                                                </Frame>
                                                            </Frame>
                                                            
                                                            <Label Grid.Column="1"
                                                                Text="{Binding Texto}" 
                                                                VerticalOptions="Center"
                                                                FontSize="14"
                                                                FontFamily="BreeSerif-Regular.ttf"
                                                                TextColor="#202124"
                                                                LineBreakMode="WordWrap" />
                                                        </Grid>
                                                        
                                                        <Frame.GestureRecognizers>
                                                            <TapGestureRecognizer 
                                                                Command="{Binding BindingContext.SeleccionarOpcionCommand, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                                                CommandParameter="{Binding Texto}"
                                                                NumberOfTapsRequired="1"
                                                               />
                                                        </Frame.GestureRecognizers>
                                                    </Frame>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </Frame>

                            </VerticalStackLayout>
                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Navigation Buttons - Hidden if single page -->
            <HorizontalStackLayout HorizontalOptions="Center" 
                Margin="0,16,0,20" 
                Spacing="16"
                Padding="16,0"
                IsVisible="{Binding MostrarPaginacion}">
                
                <Button Text="⬅️ Anterior"
                        Command="{Binding PaginaAnteriorCommand}"
                        IsEnabled="{Binding PuedeRetroceder}"
                        Padding="16,10"
                        CornerRadius="6"
                        BackgroundColor="#4285F4"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14" />

                <Button Text="Siguiente ➡️"
                        Command="{Binding SiguientePaginaCommand}"
                        IsEnabled="{Binding PuedeAvanzar}"
                        Padding="16,10"
                        CornerRadius="6"
                        BackgroundColor="#4285F4"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14" />
            </HorizontalStackLayout>

            <!-- Submit Button - Only visible on last page -->
            <Button Text="✓ Enviar respuestas"
                    Command="{Binding GuardarRespuestasCommand}"
                    IsVisible="{Binding EsUltimaPagina}"
                    Padding="16,14"
                    BackgroundColor="#34A853"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="6"
                    Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>     
</ContentPage>
