<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.PlanSeguroPage"
             Title="Plan Seguro">
    <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <!-- Título principal -->
      <Label
        Text="Tu Plan Seguro"
        FontFamily="BreeSerif-Regular.ttf"
        FontSize="24"
        FontAttributes="Bold"
        HorizontalOptions="Center" />

      <!-- Contenido del plan -->
            <!-- Frame contenedor general -->
            <Frame
                BackgroundColor="White"
                BorderColor="#DDD"
                CornerRadius="16"
                Padding="20"
                HasShadow="True">

                <!-- Lista de pasos dentro del frame -->
                <VerticalStackLayout
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding ConsejosPlanSeguro}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Titulo}"
                                       FontFamily="BreeSerif-Regular.ttf"
                                       FontAttributes="Bold"
                                       TextColor="#222"/>

                                <Label Text="{Binding Contenido}"
                                       FontFamily="BreeSerif-Regular.ttf"
                                       FontSize="14"
                                       TextColor="#444"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Frame>
            <Label 
                Text="{Binding NumeroEmergencia, StringFormat='Contacto emergencia: {0}'}"
                TextColor="Blue"
                FontAttributes="Bold"
                TextDecorations="Underline"
                HorizontalOptions="Center">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding LlamarCommand}"
                        CommandParameter="{Binding NumeroEmergencia}" />
                </Label.GestureRecognizers>
            </Label>
    </VerticalStackLayout>
 </ScrollView>
</ContentPage>