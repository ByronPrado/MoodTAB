<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.PlanSeguroPage"
             Title="PlanSeguroPage">
    <VerticalStackLayout>
        <Label 
            Text="Este es tu plan seguro."
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="24"
        />
        <Frame 
            Margin="20"
            Padding="10"
            BorderColor="Gray"
            CornerRadius="10"
            HasShadow="True">
            <Label 
                Text="Ingresa detalles del plan seguro"
                Margin="20"
            />            
        </Frame>
    </VerticalStackLayout>
</ContentPage>