<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MoodTAB.Vistas.PlanSeguroPage"
    Title="Plan Seguro">
    <NavigationPage.TitleView>
        <Grid>
            <Label Text="    📘 Plan Seguro"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>
    <Grid>
        <ScrollView BackgroundColor="#FFF5F5F5">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- DEBUG-->
                <Entry Text="{Binding LogTxt}" IsVisible="False"></Entry>
                <!-- DEBUG-->
                
                <!-- Card 1: Señales de alerta -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="10"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🚨 Señales de alerta" 
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            FontSize="18"
                            TextColor="#FF2F8CD3" />
                        <BoxView HeightRequest="1" BackgroundColor="#FFCFD7DD" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SenalesAlerta}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" 
                                        FontFamily="BreeSerif-Regular.ttf"
                                        FontSize="14"
                                        TextColor="#FF424242"
                                        LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• " TextColor="#FF2F8CD3" FontAttributes="Bold" />
                                                <Span Text="{Binding .}" FontFamily="BreeSerif-Regular.ttf" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Card 2: Estrategias internas -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="10"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🧠 Estrategias internas" 
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            FontSize="18"
                            TextColor="#388E3C" />
                        <BoxView HeightRequest="1" BackgroundColor="#E8F5E9" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EstrategiasInternas}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                        FontFamily="BreeSerif-Regular.ttf"
                                        FontSize="14"
                                        TextColor="#424242"
                                        LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• " TextColor="#388E3C" FontAttributes="Bold" />
                                                <Span Text="{Binding .}" FontFamily="BreeSerif-Regular.ttf" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Card 3: Ambiente seguro -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="10"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🏠 Ambiente seguro" 
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            FontSize="18"
                            TextColor="#1976D2" />
                        <BoxView HeightRequest="1" BackgroundColor="#E3F2FD" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AmbienteSeguro}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}"
                                        FontFamily="BreeSerif-Regular.ttf"
                                        FontSize="14"
                                        TextColor="#424242"
                                        LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• " TextColor="#1976D2" FontAttributes="Bold" />
                                                <Span Text="{Binding .}" FontFamily="BreeSerif-Regular.ttf" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Card 4: Personas para distraerme -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="10"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🎭 Personas para distraerme" 
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            FontSize="18"
                            TextColor="#FF75C12A" />
                        <BoxView HeightRequest="1" BackgroundColor="#FFD1DFC3" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PersonasDistraerme}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="10" Padding="8" BackgroundColor="#FAFAFA" >
                                        <Label Text="{Binding Nombre}" 
                                            FontFamily="BreeSerif-Regular.ttf"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            VerticalOptions="Center" />
                                        <Label Text="{Binding Fono}"
                                            FontSize="13"
                                            TextColor="#1976D2"
                                            TextDecorations="Underline"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LlamarCommand}"
                                                    CommandParameter="{Binding Fono}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Card 5: Personas a quienes pedir ayuda -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="10"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🆘 Personas a quienes pedir ayuda" 
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            FontSize="18"
                            TextColor="#FF6B35C1" />
                        <BoxView HeightRequest="1" BackgroundColor="#F3E5F5" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PersonasPedirAyuda}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="10" Padding="8" BackgroundColor="#FAFAFA">
                                        <Label Text="{Binding Nombre}" 
                                            FontFamily="BreeSerif-Regular.ttf"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            VerticalOptions="Center" />
                                        <Label Text="{Binding Fono}"
                                            FontSize="13"
                                            TextColor="#1976D2"
                                            TextDecorations="Underline"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LlamarCommand}"
                                                    CommandParameter="{Binding Fono}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Card 6: Telefonos de emergencia -->
                <Frame BackgroundColor="White"
                        CornerRadius="16"
                        HasShadow="True"
                        Padding="10"
                        Margin="0,0,0,12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🏥 Telefonos de emergencia" 
                            FontAttributes="Bold"
                            FontFamily="BreeSerif-Regular.ttf"
                            FontSize="18"
                            TextColor="#FFBE308F" />
                        <BoxView HeightRequest="1" BackgroundColor="#FCE4EC" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Profesionales}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="10" Padding="8" BackgroundColor="#FAFAFA">
                                        <Label Text="{Binding Nombre}" 
                                            FontFamily="BreeSerif-Regular.ttf"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            VerticalOptions="Center" />
                                        <Label Text="{Binding Fono}"
                                            FontSize="13"
                                            TextColor="#1976D2"
                                            TextDecorations="Underline"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LlamarCommand}"
                                                    CommandParameter="{Binding Fono}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Edit Button -->
                <Button Text="📝 Editar Plan Seguro"
                    FontSize="16"
                    TextColor="White"
                    BackgroundColor="#1976D2"
                    FontFamily="BreeSerif-Regular.ttf"
                    HeightRequest="50"
                    Margin="0,8,0,0"
                    Clicked="onEditarPlanSeguroClicked"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay de carga -->
        <Grid x:Name="LoadingOverlay"
            BackgroundColor="#FFF5F5F5"   
            IsVisible="{Binding IsBusy}"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            VerticalOptions="Fill"
            HorizontalOptions="Fill"
            ZIndex="99">
            <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#1976D2" WidthRequest="50" HeightRequest="50"/>
                <Label Text="Cargando..." TextColor="#191919" FontSize="16" HorizontalOptions="Center" FontFamily="BreeSerif-Regular.ttf"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
