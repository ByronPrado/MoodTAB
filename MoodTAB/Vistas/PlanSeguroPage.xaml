<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MoodTAB.Vistas.PlanSeguroPage"
    Title="Plan Seguro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Tu Plan Seguro"
                FontFamily="BreeSerif-Regular.ttf"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
            <Entry Text="{Binding LogTxt}" ></Entry>
            <!-- Señales de alerta -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🚨 Señales de alerta" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SenalesAlerta}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="•  " >
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="• " />
                                            <Span Text="{Binding .}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Estrategias internas -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🧠 Estrategias internas" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EstrategiasInternas}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="•  ">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="• " />
                                            <Span Text="{Binding .}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Ambiente seguro -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🏠 Ambiente seguro" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AmbienteSeguro}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="•  ">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="• " />
                                            <Span Text="{Binding .}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Personas para distraerme -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🎭 Personas para distraerme" FontAttributes="Bold" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PersonasDistraerme}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10" Padding="6">
                                    <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                        <Label Text="{Binding Fono}" FontSize="12" TextColor="#333" />
                                    </VerticalStackLayout>

                                    <Button Text="Llamar"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LlamarCommand}"
                                            CommandParameter="{Binding Fono}"
                                            CornerRadius="8"
                                            HeightRequest="36" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Personas a quienes pedir ayuda -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🆘 Personas a quienes pedir ayuda" FontAttributes="Bold" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PersonasPedirAyuda}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10" Padding="6">
                                    <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                        <Label Text="{Binding Fono}" FontSize="12" TextColor="#333" />
                                    </VerticalStackLayout>

                                    <Button Text="Llamar"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LlamarCommand}"
                                            CommandParameter="{Binding Fono}"
                                            CornerRadius="8"
                                            HeightRequest="36" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Profesionales -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="👩‍⚕️ Profesionales" FontAttributes="Bold" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Profesionales}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10" Padding="6">
                                    <VerticalStackLayout HorizontalOptions="StartAndExpand" Spacing="2">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                        <Label Text="{Binding Fono}" FontSize="12" TextColor="#333" />
                                    </VerticalStackLayout>

                                    <Button Text="Llamar"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LlamarCommand}"
                                            CommandParameter="{Binding Fono}"
                                            CornerRadius="8"
                                            HeightRequest="36" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Número de emergencia (visible si hay valor) -->
            <Frame BackgroundColor="White" BorderColor="#DDD" CornerRadius="12" Padding="12" HasShadow="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="📞 Número de emergencia" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="{Binding NumeroEmergencia}" VerticalOptions="Center" />
                        <Button Text="Llamar"
                                Command="{Binding LlamarCommand}"
                                CommandParameter="{Binding NumeroEmergencia}"
                                CornerRadius="8"
                                HeightRequest="36" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
            <Button Text="📝 Editar Plan Seguro"
                FontSize="16"
                TextColor="#FFE1E1E1"
                BackgroundColor="#FF004B9C"
                FontFamily="BreeSerif-Regular.ttf"
                HeightRequest="50"
                Clicked="onEditarPlanSeguroClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
