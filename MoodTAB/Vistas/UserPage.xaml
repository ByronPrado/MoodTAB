<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.UserPage"
             BackgroundColor="#F8F9FA">

    <NavigationPage.TitleView>
        <Grid>
            <Label Text="           Mi Perfil"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>

    <Grid Grid.Row="1" Padding="20,20,20,20">
        <ScrollView
            VerticalScrollBarVisibility="Always"
            HorizontalScrollBarVisibility="Never">
            <StackLayout Spacing="15">
                <StackLayout HorizontalOptions="Center" Spacing="0">
                    <Grid RowDefinitions="*,*">
                        <Ellipse BackgroundColor="#6B8DD6"
                                 WidthRequest="125" 
                                 HeightRequest="125"
                                 Grid.Row="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>
                        <Image Source="{Binding ImagenPerfil}"
                                WidthRequest="120"
                                HeightRequest="120"
                                Grid.Row="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Aspect="AspectFill">
                            <Image.Clip>
                                <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                            </Image.Clip>
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CambiarFotoCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                </StackLayout>
                
                <Frame BackgroundColor="White"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="10"
                   Margin="0,0,0,12">
                <!-- Información -->
                <StackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,35">
                        <Label Text="Información Personal"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#1F2937"
                            VerticalOptions="Center"
                            FontFamily="BreeSerif-Regular.ttf"
                            Grid.Column="0"
                            Margin="0,0,0,10"/>

                        <Button Text="✏️"
                                Command="{Binding EditarCommand}" 
                                Grid.Column="1" 
                                HeightRequest="35"
                                WidthRequest="35"
                                Padding="0"
                                VerticalOptions="Center"
                                IsEnabled="{Binding IsNotEditing}"
                                FontSize="14"
                                TextColor="#FFE1E1E1"
                                BackgroundColor="#FF567ED3"
                                FontFamily="BreeSerif-Regular.ttf"/>
                    </Grid>

                    
                    
                    <!-- Nombre -->
                    <Grid HeightRequest="40"
                            ColumnSpacing="10"
                            ColumnDefinitions="25,70,*">
                        
                        <Label Grid.Column="0"
                               Text="👤"
                               FontSize="20"
                               TextColor="#6B7280"
                               VerticalOptions="Center"/>
                        
                        <Label Grid.Column="1"
                               Text="Nombre: "
                               FontSize="16"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               HorizontalOptions="End"
                               VerticalOptions="Center"/>
                        
                        <Label Grid.Column="2"
                               Text="{Binding Nombre}"
                               FontSize="16"
                               TextColor="#1F2937"
                               FontFamily="BreeSerif-Regular.ttf"
                               VerticalOptions="Center"
                               HorizontalOptions="Start">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Entry Grid.Column="2"
                               Text="{Binding Nombre}"
                               FontSize="16"
                               WidthRequest="130"
                               MaximumWidthRequest="130"
                               HorizontalTextAlignment="Start"
                               TextColor="#1F2937"
                               VerticalOptions="Center"
                               FontFamily="BreeSerif-Regular.ttf"
                               HorizontalOptions="Start">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsEditing}" Value="False">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Grid>

                    <!-- Telefono -->
                    <Grid HeightRequest="40"
                          ColumnSpacing="10"
                          ColumnDefinitions="25,70,*">
                        
                        <Label Grid.Column="0"
                               Text="📞"
                               FontSize="20"
                               TextColor="#6B7280"
                               VerticalOptions="Center"/>
                        
                        <Label Grid.Column="1"
                               Text="Teléfono: "
                               FontSize="16"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               HorizontalOptions="End"
                               VerticalOptions="Center"/>
                        
                        <Label Grid.Column="2"
                               Text="{Binding Telefono}"
                               FontSize="16"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#1F2937"
                               VerticalOptions="Center"
                               HorizontalOptions="Start">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Entry Grid.Column="2"
                               Text="{Binding Telefono}"
                               FontSize="16"
                               TextColor="#1F2937"
                               VerticalOptions="Center"
                               WidthRequest="130"
                               MaximumWidthRequest="130"
                               HorizontalTextAlignment="Start"
                               FontFamily="BreeSerif-Regular.ttf"
                               HorizontalOptions="Start">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsEditing}" Value="False">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Grid>
                    
                    <!-- Email -->
                    <Grid HeightRequest="40"
                          ColumnSpacing="10"
                          ColumnDefinitions="25,70,*">
                        
                        <Label Grid.Column="0"
                               Text="📧"
                               FontSize="20"
                               TextColor="#6B7280"
                               VerticalOptions="Center"/>
                        
                        <Label Grid.Column="1"
                               Text="Email: "
                               FontSize="16"
                               FontFamily="BreeSerif-Regular.ttf"
                               TextColor="#6B7280"
                               HorizontalOptions="End"
                               VerticalOptions="Center"/>
                        
                        <Label Grid.Column="2"
                               Text="{Binding Email}"
                               FontSize="16"
                               TextColor="#1F2937"
                               FontFamily="BreeSerif-Regular.ttf"
                               VerticalOptions="Center"
                               HorizontalOptions="Start">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Entry Grid.Column="2"
                               Text="{Binding Email}"
                               FontSize="16"
                               TextColor="#1F2937"
                               VerticalOptions="Center"
                               WidthRequest="130"
                               MaximumWidthRequest="130"
                               HorizontalTextAlignment="Start"
                               FontFamily="BreeSerif-Regular.ttf"
                               HorizontalOptions="Start">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding IsEditing}" Value="False">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </Grid>
                    
                    
                    <Grid ColumnDefinitions="auto,auto" HorizontalOptions="End" ColumnSpacing="10">
                    <Button Text="Cancelar"
                            Command="{Binding CancelarCommand}" 
                            Grid.Column="1" 
                            WidthRequest="90" 
                            FontSize="14"
                            TextColor="#FFE1E1E1"
                            BackgroundColor="#FF567ED3"
                            FontFamily="BreeSerif-Regular.ttf"
                            IsVisible="{Binding IsEditing}"
                            HeightRequest="50"/>

                    <Button Text="Guardar Cambios"
                            Command="{Binding GuardarCambiosCommand}"
                            Grid.Column="0" 
                            FontSize="14"
                            TextColor="#FFE1E1E1"
                            BackgroundColor="#FF567ED3"
                            FontFamily="BreeSerif-Regular.ttf"
                            IsVisible="{Binding IsEditing}"/>
                    </Grid>
                </StackLayout>
                </Frame>
                <StackLayout Spacing="10" Margin="0,5,0,0">
                    <Button Text="🗑️ Borrar Datos"
                            FontSize="16"
                            TextColor="#FFE1E1E1"
                            BackgroundColor="#FF4C6CB0"
                            FontFamily="BreeSerif-Regular.ttf"
                            HeightRequest="50"
                            Clicked="onBorrarDatosClicked"/>
                    <Button Text="🚪 Cerrar Sesión"
                            FontSize="16"
                            TextColor="#FFE1E1E1"
                            BackgroundColor="#FF4C6CB0"
                            FontFamily="BreeSerif-Regular.ttf"
                            HeightRequest="50"
                            Clicked="OnLogoutClicked"/>
                </StackLayout>
            </StackLayout>        
        </ScrollView>
    </Grid>
</ContentPage>