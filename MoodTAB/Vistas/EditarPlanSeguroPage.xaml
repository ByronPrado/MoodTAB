<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:MoodTAB.Converters"
             x:Class="MoodTAB.Vistas.EditarPlanSeguroPage"
             x:Name="RootPage"
             Title="Editar Plan Seguro">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <NavigationPage.TitleView>
        <Grid >
            <Label Text="    📝 Editar Plan Seguro"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>

    <ScrollView BackgroundColor="#FFF3F3FF">
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- === FRAME PRINCIPAL === -->
            <Frame BackgroundColor="White"
                   CornerRadius="12"
                   BorderColor="#DDD"
                   Padding="15"
                   HasShadow="False">

                <VerticalStackLayout Spacing="20">

                    <!-- ========= SEÑALES DE ALERTA ========= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Label Text="🚨 Señales de alerta"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   FontFamily="BreeSerif-Regular.ttf" />
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Spacing="10">
                                <Frame >
                                    <Grid RowDefinitions="*,*">
                                        <VerticalStackLayout  Grid.Row="0" BindableLayout.ItemsSource="{Binding SenalesAlerta}">
                                
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="10">

                                                        <Label Text="{Binding .}"
                                                            HorizontalOptions="StartAndExpand"
                                                            FontFamily="BreeSerif-Regular.ttf" />

                                                        <Button Text="🗑️"
                                                                HorizontalOptions="End"
                                                                FontSize="14"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#777"
                                                                Command="{Binding BindingContext.EliminarSenalAlertaCommand, Source={x:Reference RootPage}}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>                                

                                        <HorizontalStackLayout   Grid.Row="1" Spacing="10">
                                            <Entry Placeholder="Nueva señal de alerta"
                                                Text="{Binding NuevoItemTexto}"
                                                FontFamily="BreeSerif-Regular.ttf"
                                                HorizontalOptions="FillAndExpand" />

                                            <Button Text="Agregar"
                                                    Command="{Binding AgregarSenalAlertaCommand}"
                                                    BackgroundColor="#16A34A"
                                                    TextColor="White"
                                                    CornerRadius="8" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>


                    <!-- ========= ESTRATEGIAS INTERNAS ========= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Label Text="🧠 Estrategias internas"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   FontFamily="BreeSerif-Regular.ttf" />
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Spacing="10">
                                <Frame >
                                    <Grid RowDefinitions="*,*">
                                        <VerticalStackLayout Grid.Row="0" BindableLayout.ItemsSource="{Binding EstrategiasInternas}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="10">

                                                        <Label Text="{Binding .}"
                                                            HorizontalOptions="StartAndExpand"
                                                            FontFamily="BreeSerif-Regular.ttf" />

                                                        <Button Text="🗑️"
                                                                FontSize="14"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#777"
                                                                Command="{Binding BindingContext.EliminarEstrategiaInternaCommand, Source={x:Reference RootPage}}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>                                

                                        <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                            <Entry Placeholder="Nueva estrategia interna"
                                                Text="{Binding NuevoItemTexto}"
                                                FontFamily="BreeSerif-Regular.ttf"
                                                HorizontalOptions="FillAndExpand" />
                                            <Button Text="Agregar"
                                                    Command="{Binding AgregarEstrategiaInternaCommand}"
                                                    BackgroundColor="#16A34A"
                                                    TextColor="White"
                                                    CornerRadius="8" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Frame>                                
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>


                    <!-- ========= AMBIENTE SEGURO ========= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Label Text="🏠 Ambiente seguro"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   FontFamily="BreeSerif-Regular.ttf" />
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Spacing="10">
                                <Frame >
                                    <Grid RowDefinitions="*,*">
                                        <VerticalStackLayout Grid.Row="0" BindableLayout.ItemsSource="{Binding AmbienteSeguro}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="10">

                                                        <Label Text="{Binding .}"
                                                            HorizontalOptions="StartAndExpand"
                                                            FontFamily="BreeSerif-Regular.ttf" />

                                                        <Button Text="🗑️"
                                                                FontSize="14"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#777"
                                                                Command="{Binding BindingContext.EliminarAmbienteSeguroCommand, Source={x:Reference RootPage}}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Row="1" Spacing="10">
                                            <Entry Placeholder="Nuevo ambiente seguro"
                                                Text="{Binding NuevoItemTexto}"
                                                FontFamily="BreeSerif-Regular.ttf"
                                                HorizontalOptions="FillAndExpand" />

                                            <Button Text="Agregar"
                                                    Command="{Binding AgregarAmbienteSeguroCommand}"
                                                    BackgroundColor="#16A34A"
                                                    TextColor="White"
                                                    CornerRadius="8" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>


                    <!-- ========= PERSONAS PARA DISTRAERME ========= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Label Text="🎭 Personas para distraerme"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   FontFamily="BreeSerif-Regular.ttf" />
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Spacing="10">
                                <Frame >
                                    <Grid RowDefinitions="*,*,*,*">
                                        <VerticalStackLayout Grid.Row="0" BindableLayout.ItemsSource="{Binding PersonasDistraerme}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="10">

                                                        <VerticalStackLayout Spacing="2" HorizontalOptions="StartAndExpand">
                                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                                            <Label Text="{Binding Fono}" FontSize="12" TextColor="#555" />
                                                        </VerticalStackLayout>

                                                        <Button Text="🗑️"
                                                                FontSize="14"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#777"
                                                                Command="{Binding BindingContext.EliminarPersonaDistraermeCommand, Source={x:Reference RootPage}}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>                                

                                        <Entry Grid.Row="1" Placeholder="Nombre"
                                            Text="{Binding NuevoNombreContacto}"
                                            FontFamily="BreeSerif-Regular.ttf" />

                                        <Entry Grid.Row="2" Placeholder="Teléfono"
                                            Text="{Binding NuevoFonoContacto}"
                                            Keyboard="Telephone"
                                            FontFamily="BreeSerif-Regular.ttf" />

                                        <Button Grid.Row="3" Text="Agregar"
                                                Command="{Binding AgregarPersonaDistraermeCommand}"
                                                BackgroundColor="#16A34A"
                                                TextColor="White"
                                                CornerRadius="8" />
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>


                    <!-- ========= PERSONAS A QUIEN PEDIR AYUDA ========= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Label Text="🆘 Personas a quienes pedir ayuda"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   FontFamily="BreeSerif-Regular.ttf" />
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Spacing="10">
                                <Frame >
                                    <Grid RowDefinitions="*,*,*,*">
                                        <VerticalStackLayout Grid.Row="0" BindableLayout.ItemsSource="{Binding PersonasPedirAyuda}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="10">

                                                        <VerticalStackLayout Spacing="2" HorizontalOptions="StartAndExpand">
                                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                                            <Label Text="{Binding Fono}" FontSize="12" TextColor="#555" />
                                                        </VerticalStackLayout>

                                                        <Button Text="🗑️"
                                                                FontSize="14"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#777"
                                                                Command="{Binding BindingContext.EliminarPersonaPedirAyudaCommand, Source={x:Reference RootPage}}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Entry Grid.Row="1" Placeholder="Nombre"
                                            Text="{Binding NuevoNombreContacto}"
                                            FontFamily="BreeSerif-Regular.ttf" />

                                        <Entry Grid.Row="2" Placeholder="Teléfono"
                                            Text="{Binding NuevoFonoContacto}"
                                            Keyboard="Telephone"
                                            FontFamily="BreeSerif-Regular.ttf" />

                                        <Button Grid.Row="3" Text="Agregar"
                                                Command="{Binding AgregarPersonaPedirAyudaCommand}"
                                                BackgroundColor="#16A34A"
                                                TextColor="White"
                                                CornerRadius="8" />
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>


                    <!-- ========= PROFESIONALES ========= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Label Text="👩‍⚕️ Profesionales"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   FontFamily="BreeSerif-Regular.ttf" />
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Spacing="10">
                                <Frame >
                                    <Grid RowDefinitions="*,*,*,*">
                                        <VerticalStackLayout Grid.Row="0" BindableLayout.ItemsSource="{Binding Profesionales}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <HorizontalStackLayout Spacing="10">

                                                        <VerticalStackLayout Spacing="2" HorizontalOptions="StartAndExpand">
                                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                                            <Label Text="{Binding Fono}" FontSize="12" TextColor="#555" />
                                                        </VerticalStackLayout>

                                                        <Button Text="🗑️"
                                                                FontSize="14"
                                                                BackgroundColor="Transparent"
                                                                TextColor="#777"
                                                                Command="{Binding BindingContext.EliminarProfesionalCommand, Source={x:Reference RootPage}}"
                                                                CommandParameter="{Binding .}" />
                                                    </HorizontalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Entry Grid.Row="1" Placeholder="Nombre"
                                            Text="{Binding NuevoNombreContacto}"
                                            FontFamily="BreeSerif-Regular.ttf" />

                                        <Entry Grid.Row="2" Placeholder="Teléfono"
                                            Text="{Binding NuevoFonoContacto}"
                                            Keyboard="Telephone"
                                            FontFamily="BreeSerif-Regular.ttf" />

                                        <Button Grid.Row="3" Text="Agregar"
                                                Command="{Binding AgregarProfesionalCommand}"
                                                BackgroundColor="#16A34A"
                                                TextColor="White"
                                                CornerRadius="8" />
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>

                </VerticalStackLayout>
            </Frame>

            <!-- ========= GUARDAR ========= -->
            <Button Text="Guardar Plan Seguro"
                    Command="{Binding GuardarCommand}"
                    BackgroundColor="#16A34A"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
