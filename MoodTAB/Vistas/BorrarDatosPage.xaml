<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.BorrarDatosPage"
             Title="Eliminar mis datos">
             <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="20">

      <!-- Título principal -->
      <Label
        Text="Ley 19.628 – Protección de Datos Personales"
        FontSize="22"
        FontAttributes="Bold"
        HorizontalOptions="Center" />

      <!-- Resumen de los derechos de cancelación -->
      <Frame
        BorderColor="Gray"
        CornerRadius="8"
        HasShadow="True"
        Padding="15">
        <VerticalStackLayout Spacing="8">

          <Label Text="• Ley N° 19.628: regula el tratamiento de datos personales mediante consentimiento informado y lealtad." />

          <Label Text="• Derecho ARCO: Acceso, Rectificación, Cancelación y Oposición de tus datos." />

          <Label Text="• Art. 13 N° 2 – Derecho de Cancelación: solicita la eliminación de datos inexactos, innecesarios o caducados." />

          <Label Text="• Plazos de atención: respuesta en 10 días hábiles; ejecución de la cancelación en 20 días hábiles." />

          <Label Text="• Vías de reclamo: puedes acudir al Consejo para la Transparencia o la vía judicial en caso de negativa o silencio." />

        </VerticalStackLayout>
      </Frame>

      <!-- Sección de aceptación y envío -->
      <Frame
        BorderColor="Gray"
        CornerRadius="8"
        HasShadow="True"
        Padding="10">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">

          <CheckBox
            x:Name="check_aceptar"
            Grid.Column="0"
            VerticalOptions="Center"
            CheckedChanged="OnCheckBoxCheckedChanged" />

          <Label
            Text="He leído y acepto eliminar mis datos"
            Grid.Column="1"
            VerticalOptions="Center"
            LineBreakMode="WordWrap" />

          <Button
            x:Name="btnEnviar"
            Grid.Column="2"
            Text="Enviar solicitud"
            Clicked="OnEnviarSolicitudClicked" />

        </Grid>
      </Frame>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>