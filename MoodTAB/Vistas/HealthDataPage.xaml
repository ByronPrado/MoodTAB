<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.HealthDataPage"
             Title="HealthData">
    
    <ScrollView>
        <VerticalStackLayout>      
            <Label Text="Health Connect Demo" FontSize="24" />
            <Label Text="Pasos:" />
            <Label Text="{Binding StepsText}" />

            <Label Text="Sueño:" />
            <Label Text="{Binding SleepText}" />

            <Button Text="Cargar Datos de Salud" Command="{Binding LoadHealthDataCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>