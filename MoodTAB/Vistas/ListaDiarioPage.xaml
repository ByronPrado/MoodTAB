<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoodTAB.Vistas.ListaDiarioPage"
             x:Name="ThisPage"
             BackgroundColor="#FFF3F3FF">
        <!-- Título de navegación -->
    <NavigationPage.TitleView>
        <Grid>
            <Label Text="📚 Mis Diarios"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontFamily="BreeSerif-Regular.ttf"
                   TextColor="#FF191919"/>
        </Grid>
    </NavigationPage.TitleView>
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="5">

            <!-- Botón para nuevo diario -->
            <Button Text="➕ Ingresar nuevo diario"
                    Clicked="OnNewSeleccionado"
                    Margin="6,5,6,10"
                    HeightRequest="50">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0.0" />
                        <GradientStop Color="#10B981" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- Label de error -->
            <Label x:Name="ErrorLabel"
                TextColor="Red"
                FontSize="14"
                IsVisible="False" />

            <!-- CollectionView opcional de diarios (oculto) -->
            <CollectionView ItemsSource="{Binding ListaDiarios}"
                            SelectionMode="Single"
                            SelectionChanged="OnDiarioSeleccionado"
                            HeightRequest="400"
                            IsVisible="true">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#6B8DD6"
                            BorderColor="#6B8DD6"
                            HasShadow="True"
                            Padding="10"
                            Margin="5"
                            IsClippedToBounds="False"
                            InputTransparent="True">
                            <VerticalStackLayout>
                                <Grid RowDefinitions="*,*">
                                    <Label Text="Diario ingresado a las:" Grid.Row="0" Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontFamily="BreeSerif-Regular.ttf"
                                        TextColor="White"/>
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}" Grid.Row="1" Grid.Column="0"
                                        FontSize="16"
                                        FontFamily="BreeSerif-Regular.ttf"
                                        TextColor="White"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>