<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="MoodTAB.Popups.TutorialPopup"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">

    <!-- Fondo completo con animación -->
    <Grid x:Name="RootGrid"
          BackgroundColor="#80000000"
          Opacity="0"
          Padding="20"
          RowDefinitions="*,Auto">

        <!-- FRAME flotante -->
        <Frame x:Name="Card"
               BackgroundColor="White"
               CornerRadius="24"
               Padding="24"
               HasShadow="True"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               WidthRequest="340"
               HeightRequest="500"
               Scale="0.9">

            <Grid RowDefinitions="Auto,*,Auto">

                <Label Text="Bienvenido a MOODTAB"
                       FontSize="20"
                       FontAttributes="Bold"
                       FontFamily="BreeSerif-Regular.ttf"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <CarouselView x:Name="TutorialCarousel"
                            Grid.Row="1"
                            IndicatorView="indicator"
                            PositionChanged="OnPositionChanged"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">

                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="10"
                                                Padding="20"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="FillAndExpand">
                                <Label Text="{Binding Title}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Description}"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center" />
                                <Image Source ="{Binding Imagen}"
                                    HeightRequest="180"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>

                </CarouselView>

                <IndicatorView x:Name="indicator"
                               Grid.Row="2"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
            </Grid>
        </Frame>

        <!-- Botones -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
            <Button x:Name="SkipButton"
                    Text="Saltar tutorial"
                    Clicked="OnSkip"
                    BackgroundColor="Transparent"
                    TextColor="LightGray"
                    FontAttributes="Bold"/>

            <Button x:Name="NextButton"
                    Text="Siguiente"
                    Clicked="OnNext"
                    Grid.Column="1"
                    BackgroundColor="#5A67D8"
                    TextColor="White"
                    CornerRadius="12"
                    WidthRequest="120"/>
        </Grid>
    </Grid>
</toolkit:Popup>
