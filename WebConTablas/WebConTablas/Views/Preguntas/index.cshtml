@model IEnumerable<WebConTablas.Models.Pregunta>
@using System.Text.Json

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Preguntas - MindCare Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/css/paginas.css")" />
    <style>
        .onboarding-steps { display: flex; flex-direction: column; gap: 1.5rem; }
        .onboarding-step { display: flex; align-items: flex-start; gap: 1.5rem; }
        .onboarding-icon { flex-shrink: 0; width: 50px; height: 50px; background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
        .onboarding-text p { margin-bottom: 0; color: var(--bs-secondary-color); }
    </style>
</head>
<body>
    <div class="main-container">
        <!-- Sidebar with Questions List -->
        <div class="sidebar">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">
                    Preguntas
                </h4>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnReabrirOnboardingPreguntas">
                    <i class="fas fa-question-circle me-1"></i> Ver Tour
                </button>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Agregar pregunta
                </a>
            </div>

            <!-- Search Box -->
            <div class="search-box">
                <input type="text" class="form-control" placeholder="Buscar preguntas..." id="searchInput" onkeyup="filterQuestions()">
                <i class="fas fa-search"></i>
            </div>

            <!-- Questions List -->
            <div class="card-list-preguntas" id="questions-list">
                @foreach (var pregunta in Model)
                {
                    <div class="white-card" data-question-id="@pregunta.ID_Pregunta" onclick="showQuestionDetails(@pregunta.ID_Pregunta)">
                        <div class="d-flex align-items-start mb-2">
                            <div class="flex-grow-1">
                                <h6 class="mb-1" id="pregunta-content">@pregunta.Contenido</h6>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="tipo-badge tipo-@(pregunta.Tipo?.ToLower() ?? "texto")">
                                        @(pregunta.Tipo ?? "Texto")
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt me-1"></i>
                                Creada: @(pregunta.Created_at?.ToString("dd/MM/yyyy") ?? "N/A")
                            </small>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="no-data-state">
                    <i class="fas fa-question-circle"></i>
                    <h5>No hay preguntas</h5>
                    <p>Comienza creando tu primera pregunta</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Crear Primera Pregunta
                    </a>
                </div>
            }
        </div>

        <!-- Main Content Panel -->
        <div class="content-panel">
            <div id="question-details">
                <div class="detail-card">
                    <div class="no-data-state">
                        <i class="fas fa-question-circle"></i>
                        <h5>Selecciona una pregunta</h5>
                        <p>Haz clic en una pregunta de la lista para ver sus detalles y opciones</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const antiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
        
        // Store all questions data for client-side access
        const questionsData = @Html.Raw(JsonSerializer.Serialize(Model.Select(p => new {
            ID_Pregunta = p.ID_Pregunta,
            Contenido = p.Contenido,
            Opciones = p.OpcionesSeleccion?.Split(','),
            EscalaMin = p.EscalaMin,
            EscalaMax = p.EscalaMax,
            Tipo = p.Tipo,
            Created_at = p.Created_at?.ToString("dd/MM/yyyy HH:mm") ?? "N/A"
        })));

        const urls = {
            edit: '@Url.Action("Edit", "Preguntas")',
            delete: '@Url.Action("Delete", "Preguntas")',
            create: '@Url.Action("Create", "Preguntas")'
        };

        function showQuestionDetails(questionId) {
            // Remove active class from all cards
            document.querySelectorAll('.white-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to clicked card
            const clickedCard = document.querySelector(`[data-question-id="${questionId}"]`);
            if (clickedCard) {
                clickedCard.classList.add('active');
            }
            
            // Find question data
            const question = questionsData.find(q => q.ID_Pregunta === questionId);
            if (!question) return;
            
            // Update question details content
            const detailsContainer = document.getElementById('question-details');
            detailsContainer.innerHTML = generateQuestionDetailsHTML(question);
        }

        function generateQuestionDetailsHTML(question) {
            const tipoClass = `tipo-${(question.Tipo || 'texto').toLowerCase()}`;
            
            return `
                <div class="detail-card">
                    <div class="other-header">
                        <div class="flex-grow-1">
                            <h3 class="mb-1">${question.Contenido}</h3>
                        </div>
                        <div class="d-flex gap-2">
                            <form action="${urls.delete}/${question.ID_Pregunta}" method="post" style="display:inline;">
                                <input type="hidden" name="__RequestVerificationToken" value="${antiForgeryToken}" />
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar esta pregunta?');">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Tipo de Pregunta</div>
                            <div class="info-value">${question.Tipo || 'Texto'}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Fecha de Creación</div>
                            <div class="info-value">${question.Created_at}</div>
                        </div>
                    </div>
                </div>
                <div class="detail-card ${question.Tipo == "Escala"  ? ' ' : 'hidden'}">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Escala Minima</div>
                            <div class="info-value">${question.EscalaMin}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Escala Máxima</div>
                            <div class="info-value">${question.EscalaMax}</div>
                        </div>
                    </div>
                </div>

                <div class="detail-card ${question.Tipo == "Seleccion"  ? ' ' : 'hidden'}">
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Opciones</div>
                            <div class="info-value">${question.Opciones}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        const questionCards = document.querySelectorAll('.white-card');
        function filterQuestions() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            
            questionCards.forEach(card => {
                const content = card.querySelector("#pregunta-content");
                if (content.textContent.toLowerCase().includes(searchTerm)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
        let onboardingModalPreguntas; 

        document.addEventListener("DOMContentLoaded", function() {
            
            const modalElement = document.getElementById('onboardingModalPreguntas');
            if (!modalElement) return;

            // 2. Creamos la instancia del modal
            onboardingModalPreguntas = new bootstrap.Modal(modalElement);
            
            // ¡¡Usamos una clave de guardado DIFERENTE!!
            const storageKey = 'onboardingCompleto_Preguntas'; 

            // 3. Lógica para mostrar automáticamente la primera vez
            const yaVioOnboarding = localStorage.getItem(storageKey);
            if (!yaVioOnboarding) {
                onboardingModalPreguntas.show();
            }

            // 4. Lógica para "recordar" cuando el usuario lo cierra
            const btnComenzar = document.getElementById('btnComenzarOnboardingPreguntas');
            if (btnComenzar) {
                btnComenzar.addEventListener('click', () => {
                    localStorage.setItem(storageKey, 'true');
                });
            }
            
            modalElement.addEventListener('hidden.bs.modal', () => {
                if (!localStorage.getItem(storageKey)) {
                    localStorage.setItem(storageKey, 'true');
                }
            });

            // 5. Lógica para el NUEVO botón de "reabrir"
            const btnReabrir = document.getElementById('btnReabrirOnboardingPreguntas');
            if(btnReabrir) {
                btnReabrir.addEventListener('click', () => {
                    if (onboardingModalPreguntas) {
                        onboardingModalPreguntas.show(); // Simplemente lo mostramos
                    }
                });
            }
        });
        // === FIN CÓDIGO ONBOARDING ===
    </script>
    <div class="modal fade" id="onboardingModalPreguntas" tabindex="-1" aria-labelledby="onboardingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="onboardingModalLabel">
                        <i class="fas fa-magic me-2 text-primary"></i>
                        ¡Tu Biblioteca de Preguntas!
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4" style="background-color: #f8f9fa;">
                    <p class="lead text-center mb-4">Desde aquí puedes crear y gestionar todas las preguntas que usarás en tus formularios.</p>
                    
                    <div class="onboarding-steps">
                        <div class="onboarding-step">
                            <div class="onboarding-icon">
                                <i class="fas fa-plus"></i>
                            </div>
                            <div class="onboarding-text">
                                <strong>1. Crea una pregunta</strong>
                                <p>Usa el botón "<strong>+ Agregar pregunta</strong>" para crear una nueva (ej: de texto, de escala, de selección).</p>
                            </div>
                        </div>
                        
                        <div class="onboarding-step">
                            <div class="onboarding-icon">
                                <i class="fas fa-search"></i>
                            </div>
                            <div class="onboarding-text">
                                <strong>2. Busca en tu biblioteca</strong>
                                <p>La barra de "<strong>Buscar preguntas</strong>" te permite filtrar rápidamente por contenido.</p>
                            </div>
                        </div>

                        <div class="onboarding-step">
                            <div class="onboarding-icon">
                                <i class="fas fa-mouse-pointer"></i>
                            </div>
                            <div class="onboarding-text">
                                <strong>3. Revisa los detalles</strong>
                                <p>Haz clic en cualquier pregunta de la lista para ver sus detalles, tipo y opciones en el panel de la derecha.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-primary btn-lg" data-bs-dismiss="modal" id="btnComenzarOnboardingPreguntas">
                        ¡Entendido!
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
