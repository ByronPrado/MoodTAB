@model WebConTablas.Models.Psiquiatra

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="@Url.Content("~/css/site.css")" />

<div class="background">
    <div class="main-container">
        <img src="@Url.Content("~/moodtablogo_white.svg")" alt="" style="height : 100px;">
        <div class="center-card">
            <h2 class="formtitulo">Ingreso Psiquiatras</h2>
            <form asp-action="Login" method="post">
                <div>
                    <label class="formsubtitulo" for="Usuario">Email</label>
                    <input type="text" id="Usuario" name="Usuario" required class="input-login"/>
                </div>
                <div style="height: 2rem;"></div>
                <div>
                    <label class="formsubtitulo" for="Contrasena">Contraseña</label>
                    <input type="password" id="Contrasena" name="Contrasena" required class="input-login"/>
                </div>
                <input type="hidden" name="EsFamiliar" value="false" />
                @if (ViewBag.Error != null)
                {
                    <p style="height : 1rem; color:red">@ViewBag.Error</p>
                }else{
                    <p style="height : 1rem;  color:red"></p>
                }
                <button class="botonenviar btn btn-primary btn-sm" type="submit">Iniciar sesión</button>
            </form>
        </div>
    </div>
</div>





