@*
    ASUNCIÓN IMPORTANTE:
    Asumimos que el modelo es el Psiquiatra y que, de forma similar
    al modelo Paciente, este objeto CONTIENE su lista de recordatorios.
    Ej: public class Psiquiatra {
        ... (datos personales) ...
        public List<RecordatoriosPsiquiatra> Recordatorios { get; set; }
    }
    Si este no es el caso, necesitaríamos un ViewModel.
*@
@model WebConTablas.Models.Psiquiatra
@using System.Text.Json;
@{
    ViewData["Title"] = "Mi Perfil y Agenda";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link rel="stylesheet" href="@Url.Content("~/css/paciente.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/paginas.css")" />

<div class="container">
    <br>
    <h2 class="text-primary">Bienvenido, Dr/a. @(Model.Nombre ?? "Psiquiatra")</h2>
    <p>Esta es su página principal de gestión.</p>

    <ul class="nav nav-tabs mt-4" id="psiquiatraTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#calendarioTab">Mi Agenda</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#datosTab">Mis Datos</a>
        </li>
    </ul>

    <div class="tab-content mt-3">

        <div class="tab-pane fade show active" id="calendarioTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Mis Recordatorios</h3>
                <button id="btnNuevoRecordatorio" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Añadir Recordatorio
                </button>
            </div>
            <div id="calendarioRecordatorios" style="max-width: 900px; margin: auto;"></div>
        </div>

        <div class="tab-pane fade" id="datosTab">
            <h3>Mis Datos Personales</h3>
            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Nombre Completo:</dt>
                        <dd class="col-sm-9">@Model.Nombre</dd>

                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@(Model.Email ?? "No especificado")</dd>

                        <dt class="col-sm-3">Teléfono:</dt>
                        <dd class="col-sm-9">@(Model.Telefono ?? "No especificado")</dd>
                    </dl>
                    <a asp-controller="Psiquiatras" 
                       asp-action="Edit" 
                       asp-route-id="@Model.ID_Psiquiatra" 
                       class="btn btn-outline-secondary">
                        <i class="fas fa-pencil-alt"></i> Editar mis datos
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalRecordatorio" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">Gestionar Recordatorio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formRecordatorio">
                    <input type="hidden" id="recordatorioId" value="0" />
                    <input type="hidden" id="psiquiatraId" value="@Model.ID_Psiquiatra" />
                    <div class="mb-3">
                        <label for="recordatorioTitulo" class="form-label">Título</label>
                        <input type="text" class="form-control" id="recordatorioTitulo" required>
                    </div>

                    <div class="row">
                        <div class="col-md-7 mb-3">
                            <label for="recordatorioFecha" class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="recordatorioFecha" required>
                        </div>

                        <div class="col-md-5 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="recordatorioAllDay" checked>
                                <label class="form-check-label" for="recordatorioAllDay">
                                    Todo el día
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="contenedorHora" style="display: none;">
                        <label for="recordatorioHora" class="form-label">Hora</label>
                        <input type="time" class="form-control" id="recordatorioHora">
                    </div>

                    <div class="mb-3">
                        <label for="recordatorioDescripcion" class="form-label">Descripción (Opcional)</label>
                        <textarea class="form-control" id="recordatorioDescripcion" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="recordatorioColor" class="form-label">Color (Opcional)</label>
                        <input type="color" class="form-control form-control-color" id="recordatorioColor" title="Elige un color">
                    </div>
                    <div class="mb-3">
                        <label for="recordatorioGrupo" class="form-label">Grupo (Opcional)</label>
                        <select class="form-select" id="recordatorioGrupo">
                            <option value="">Otro</option>
                            <option value="Personal">Personal</option>
                            <option value="Cita">Cita</option>
                            <option value="Importante">Importante</option>
                            <option value="Reunión">Reunión</option>
                            </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-danger" id="btnEliminarRecordatorio" style="display: none;">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
                <div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnGuardarRecordatorio">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetColorFromGroup(string? grupo)
    {
        return grupo switch
        {
            "Personal" => "#0d6efd",
            "Cita" => "#198754",
            "Importante" => "#dc3545",
            "Reunión" => "#ffc107",
            _ => "#6c757d",
        };
    }
}

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // --- Preparación de Datos ---
            const modalElement = document.getElementById('modalRecordatorio');
            const modal = new bootstrap.Modal(modalElement);
            const form = document.getElementById('formRecordatorio');
            const btnGuardar = document.getElementById('btnGuardarRecordatorio');
            const btnEliminar = document.getElementById('btnEliminarRecordatorio');
            const modalLabel = document.getElementById('modalLabel');
            
            // Inputs del Modal
            const inputId = document.getElementById('recordatorioId');
            const inputPsiquiatraId = document.getElementById('psiquiatraId');
            const inputTitulo = document.getElementById('recordatorioTitulo');
            const inputFecha = document.getElementById('recordatorioFecha');
            const inputDescripcion = document.getElementById('recordatorioDescripcion');
            const inputGrupo = document.getElementById('recordatorioGrupo');
            const inputAllDay = document.getElementById('recordatorioAllDay');
            const inputHora = document.getElementById('recordatorioHora');
            const contenedorHora = document.getElementById('contenedorHora');
            const inputColor = document.getElementById('recordatorioColor');

            const groupColors = {
                "Personal": "#0d6efd",
                "Cita": "#198754",   
                "Importante": "#dc3545",
                "Reunión": "#ffc107",
                "": "#FFFFFF" 
            };
            const defaultColor = "#6c757d"; // Fallback gris
            const defaultWhite = "#FFFFFF";
            // Serializamos los recordatorios desde el Modelo C#
            // Asumimos que Model.Recordatorios existe
            let recordatorios = @Html.Raw(Json.Serialize(
                (Model.RecordatorioPsiquiatra ?? new List<WebConTablas.Models.RecordatoriosPsiquiatra>())
                .Select(r => {
                    var color = !string.IsNullOrEmpty(r.Color) 
                        ? r.Color 
                        : GetColorFromGroup(r.Grupo);
                        
                    return new {
                        id = r.ID_RecordatorioPsiquiatra,
                        title = r.Titulo,
                        start = r.Fecha?.ToString("o"), 
                        allDay = r.IsAllDay,
                        backgroundColor = color, 
                        borderColor = color,     
                        extendedProps = new {
                            descripcion = r.Descripcion,
                            grupo = r.Grupo
                        }
                    };
                })
            ));

            // --- Inicialización de FullCalendar ---
            let calendarEl = document.getElementById('calendarioRecordatorios');
            let calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'es', // Español
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                events: recordatorios,
                editable: true, // Permite arrastrar y soltar (requiere lógica de guardado)

                // --- EVENTO: Clic en un día vacío ---
                dateClick: function(info) {
                    form.reset();
                    inputId.value = "0";
                    inputFecha.value = info.dateStr;
                    
                    // Por defecto es "Todo el día"
                    inputAllDay.checked = true;
                    contenedorHora.style.display = "none";
                    inputHora.value = "";
                    inputColor.value = defaultWhite;

                    modalLabel.innerText = "Nuevo Recordatorio";
                    btnEliminar.style.display = "none";
                    modal.show();
                },

                // --- EVENTO: Clic en un evento existente ---
                eventClick: function(info) {
                    const event = info.event;
                    inputId.value = event.id;
                    inputTitulo.value = event.title;
                    
                    // Lógica para Fecha y Hora
                    const startDate = event.start;
                    if(startDate){
                        // Seteamos la fecha
                        inputFecha.value = startDate.toISOString().split('T')[0];
                        
                        if (event.allDay) {
                            inputAllDay.checked = true;
                            contenedorHora.style.display = "none";
                            inputHora.value = "";
                        } else {
                            // Seteamos la hora (formato HH:mm)
                            inputAllDay.checked = false;
                            contenedorHora.style.display = "block";
                            inputHora.value = startDate.toTimeString().split(' ')[0].substring(0, 5);
                        }
                    }

                    inputDescripcion.value = event.extendedProps.descripcion || "";
                    inputGrupo.value = event.extendedProps.grupo || "";
                    inputColor.value = event.backgroundColor || "#FFFFFF";
                    modalLabel.innerText = "Editar Recordatorio";
                    btnEliminar.style.display = "inline-block";
                    modal.show();
                },

                // --- EVENTO: Arrastrar y soltar un evento ---
                // (Opcional, pero muy útil)
                eventDrop: function(info) {
                    // TODO: Implementar llamada AJAX para actualizar la fecha
                    // del evento (info.event) en la base de datos.
                    console.log(`Evento ${info.event.id} movido a ${info.event.start.toISOString()}`);
                    // Aquí harías un fetch para actualizar solo la fecha
                }
            });
            calendar.render();

            // --- Lógica de Botones del Modal ---

            inputGrupo.addEventListener('change', function() {
                const selectedGroup = this.value;
                inputColor.value = groupColors[selectedGroup] || defaultColor; 
            });

            // Botón "Añadir Recordatorio" (fuera del modal)
            document.getElementById('btnNuevoRecordatorio').addEventListener('click', function() {
                form.reset();
                inputId.value = "0";
                inputFecha.valueAsDate = new Date(); // Pone la fecha de hoy
                modalLabel.innerText = "Nuevo Recordatorio";
                btnEliminar.style.display = "none";
                inputColor.value = "#FFFFFF"; 
                modal.show();
            });

            // Botón "Guardar" (dentro del modal)
            btnGuardar.addEventListener('click', async function() {
                const esTodoElDia = inputAllDay.checked;
                let fechaISO;
                if (esTodoElDia || !inputHora.value) {
                    // Si es todo el día o la hora está vacía, manda solo la fecha
                    fechaISO = inputFecha.value;
                } else {
                    // Si tiene hora, combina fecha y hora en formato ISO
                    fechaISO = `${inputFecha.value}T${inputHora.value}`;
                }
                // 1. Recolectar datos del formulario
                const recordatorioData = {
                    ID_RecordatorioPsiquiatra: parseInt(inputId.value) || 0,
                    ID_Psiquiatra: parseInt(inputPsiquiatraId.value),
                    Titulo: inputTitulo.value,
                    Fecha: fechaISO,
                    Descripcion: inputDescripcion.value,
                    Grupo: inputGrupo.value,
                    IsAllDay: esTodoElDia,
                    Color: inputColor.value
                };

                // Validación simple
                if (!recordatorioData.Titulo || !recordatorioData.Fecha) {
                    alert("El título y la fecha son obligatorios.");
                    return;
                }

                // 2. Enviar datos al Controller (Crear o Actualizar)
                // TODO: Crearemos este endpoint en el PsiquiatraController
                try {
                    const response = await fetch('/RecordatoriosPsiquiatra/GuardarRecordatorio', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            // Añadir token de verificación si usas Antiforgery
                        },
                        body: JSON.stringify(recordatorioData)
                    });

                    if (response.ok) {
                        const eventoGuardado = await response.json();

                        // 1. Busca el evento existente
                        const eventoExistente = calendar.getEventById(eventoGuardado.id);

                        // 2. Si existe, elimínalo del calendario
                        if (eventoExistente) {
                            eventoExistente.remove(); 
                        }

                        // 3. Añade el evento (ya sea nuevo o actualizado)
                        // El 'eventoGuardado' que viene del servidor ya tiene
                        // toda la información correcta (nueva hora, título, etc.)
                        calendar.addEvent(eventoGuardado); 
                        
                        modal.hide();
                    } else {
                        alert("Error al guardar el recordatorio.");
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert("Error de conexión al guardar.");
                }
            });

            // Botón "Eliminar" (dentro del modal)
            btnEliminar.addEventListener('click', async function() {
                if (!confirm("¿Estás seguro de que deseas eliminar este recordatorio?")) {
                    return;
                }

                const id = inputId.value;

                // TODO: Crearemos este endpoint en el PsiquiatraController
                try {
                    const response = await fetch(`/RecordatoriosPsiquiatra/EliminarRecordatorio/${id}`, {
                        method: 'POST', // O 'DELETE'
                        headers: {
                            // Añadir token de verificación si usas Antiforgery
                        }
                    });

                    if (response.ok) {
                        // Eliminar del calendario
                        const evento = calendar.getEventById(id);
                        if (evento) {
                            evento.remove();
                        }
                        modal.hide();
                    } else {
                        alert("Error al eliminar el recordatorio.");
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert("Error de conexión al eliminar.");
                }
            });
            inputAllDay.addEventListener('change', function() {
                if (this.checked) {
                    contenedorHora.style.display = "none";
                    inputHora.value = ""; // Limpia la hora si se marca "Todo el día"
                } else {
                    contenedorHora.style.display = "block";
                    inputHora.value = "09:00"; // Pone una hora por defecto
                }
            });
            inputGrupo.addEventListener('change', function() {
                const selectedGrupo = this.value;
                const newColor = jsGetColorFromGroup(selectedGrupo);
                inputColor.value = newColor; // Actualiza el selector de color
            });

        });
    </script>
}