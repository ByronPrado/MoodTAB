@model IEnumerable<WebConTablas.Models.Formulario>
@using System.Text.Json
@using System.Collections.Generic

@{
    var grupos = Model
        .Where(f => !string.IsNullOrEmpty(f.Grupo)) // evitar nulos o vacíos
        .Select(f => f.Grupo)
        .Distinct()
        .OrderBy(g => g)
        .ToList();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/css/paginas.css")" />
    <style>
        .onboarding-steps { display: flex; flex-direction: column; gap: 1.5rem; }
        .onboarding-step { display: flex; align-items: flex-start; gap: 1.5rem; }
        .onboarding-icon { flex-shrink: 0; width: 50px; height: 50px; background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
        .onboarding-text p { margin-bottom: 0; color: var(--bs-secondary-color); }
        .modal-body { background-color: #f8f9fa; }
    </style>
</head>
<body>
    <div class="main-container">
        <!-- Sidebar with Forms List -->
        <div class="sidebar">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Lista de Formularios</h4>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnReabrirOnboardingFormularios">
                    <i class="fas fa-question-circle me-1"></i> Ver Tour
                </button>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Nuevo Formulario
                </a>
            </div>

            <div class="search-box">
                <input type="text" class="form-control" placeholder="Buscar preguntas..." id="searchInput" onkeyup="filterForm()">
                <i class="fas fa-search"></i>
            </div>

            <label for="filtro-grupo">Grupo</label>
            <select id="filtro-grupo" class="form-select" onchange="filterForm()">
                <option value="all">Todos</option>
                @foreach (var grupo in grupos)
                {
                    <option value="@grupo">@grupo</option>
                }
            </select>
            <div style="height: 2rem;"></div>

            <div class="card-list-formularios">
            @foreach (var formulario in Model)
            {
                <div class="white-card" data-form-id="@formulario.ID_Formulario" onclick="showFormDetails(@formulario.ID_Formulario)">
                    <div class="d-flex align-items-center mb-2">
                        <div class="flex-grow-1">
                            <h6 class="mb-1" id="formulario-titulo">@formulario.Titulo</h6>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-2">
                            <span class="text-muted small">Preguntas: @(formulario.Preguntas?.Count() ?? 0)</span>
                        </div>
                    </div>
                    <div class="mt-2">
                        <small>@formulario.Psiquiatra?.Nombre</small>
                    </div>
                </div>
            }
            </div>
        </div>

        <!-- Main Content Panel -->
        <div class="content-panel">
            <div id="form-details">
                <div class="detail-card">
                    <div class="no-data-state">
                        <i class="fas fa-clipboard-list"></i>
                        <h5>Selecciona un formulario</h5>
                        <p>Haz clic en un formulario de la lista para ver sus detalles y preguntas</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const antiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
        // Store all form data for client-side access
        const formsData = @Html.Raw(JsonSerializer.Serialize(Model.Select(f => new {
            ID_Formulario = f.ID_Formulario,
            Titulo = f.Titulo,
            Grupo = f.Grupo,
            Descripcion = f.Descripcion,
            Created_at = f.Created_at.ToString(),
            Psiquiatra = new {
                Nombre = f.Psiquiatra?.Nombre ?? "No asignado"
            },
            Preguntas = f.Preguntas?.OrderBy(fp => fp.Orden ?? int.MaxValue).Select(fp => new {
                ID_Pregunta = fp.ID_Pregunta,
                Contenido = fp.Pregunta?.Contenido ?? "Pregunta no disponible",
                Tipo = fp.Pregunta?.Tipo,
                Orden = fp.Orden
            }).ToList()
        })));

        const urls = {
            desasignar: '@Url.Action("Desasignar", "FormularioPreguntas")',
            asignar: '@Url.Action("Asignar", "FormularioPreguntas")',
            edit: '@Url.Action("Edit", "Formularios")',
            delete: '@Url.Action("Delete", "Formularios")',
            details: '@Url.Action("Details", "Formularios")',
            index: '@Url.Action("Index", "Formularios")'
        };

        function showFormDetails(formId) {
            // Remove active class from all cards
            document.querySelectorAll('.white-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to clicked card
            const clickedCard = document.querySelector(`[data-form-id="${formId}"]`);
            if (clickedCard) {
                clickedCard.classList.add('active');
            }
            
            // Find form data
            const form = formsData.find(f => f.ID_Formulario === formId);
            if (!form) return;
            
            // Update form details content
            const detailsContainer = document.getElementById('form-details');
            detailsContainer.innerHTML = generateFormDetailsHTML(form);
        }

        function generateFormDetailsHTML(form) {
            const fechaCreacion = new Date(form.Created_at).toLocaleDateString('es-ES');
            
            let preguntasHTML = '';
            if (form.Preguntas && form.Preguntas.length > 0) {
                const sortedPreguntas = form.Preguntas.sort((a, b) => {
                    const ordenA = a.Orden || 999999;
                    const ordenB = b.Orden || 999999;
                    return ordenA - ordenB;
                });
                
                preguntasHTML = sortedPreguntas.map((pregunta, index) => `
                    <div class="question-card">
                        <div class="d-flex align-items-start">
                            <div class="me-3">
                                <span class="badge bg-primary">${pregunta.Orden || (index + 1)}</span>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-2">${pregunta.Contenido}</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">Tipo: ${pregunta.Tipo}</small>
                                    <form action="${urls.desasignar}" method="post" style="display:inline;">
                                        <input type="hidden" name="__RequestVerificationToken" value="${antiForgeryToken}" />
                                        <input type="hidden" name="formularioId" value="${form.ID_Formulario}" />
                                        <input type="hidden" name="preguntaId" value="${pregunta.ID_Pregunta}" />
                                        <button type="submit" class="btn btn-link btn-sm text-danger" onclick="return confirm('¿Desasignar esta pregunta?');">
                                            <i class="fas fa-unlink"></i> Desasignar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                `).join('');
            } else {
                preguntasHTML = `
                    <div class="no-data-state">
                        <i class="fas fa-question-circle"></i>
                        <p>No hay preguntas asignadas a este formulario</p>
                    </div>
                `;
            }

            return `
                <div class="detail-card">
                    <div class="other-header">
                        <div class="flex-grow-1">
                            <h3 class="mb-1">${form.Titulo}</h3>
                        </div>
                        <div class="d-flex gap-2">
                            <form action="${urls.delete}/${form.ID_Formulario}" method="post" style="display:inline;">
                                <input type="hidden" name="__RequestVerificationToken" value="${antiForgeryToken}" />
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('¿Seguro que deseas eliminar este formulario?');">
                                    <i class="fas fa-trash"></i> Eliminar
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    <div class="info-value">${form.Descripcion || 'Sin descripción'}</div>
                    <div style="height: 2rem;"></div>
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Psiquiatra</div>
                            <div class="info-value">${form.Psiquiatra.Nombre}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Fecha de Creación</div>
                            <div class="info-value">${fechaCreacion}</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Grupo</div>
                            <div class="info-value">${form.Grupo}</div>
                        </div>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="mb-0">
                            Preguntas Asignadas
                        </h5>
                        <a href="${urls.asignar}/${form.ID_Formulario}" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> Asignar Preguntas
                        </a>
                    </div>
                    ${preguntasHTML}
                </div>
            `;
        }

        function filterForm() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const grupoSeleccionado = document.getElementById('filtro-grupo').value;
            const questionCards = document.querySelectorAll('.white-card');

            questionCards.forEach(card => {
                const titulo = card.querySelector("#formulario-titulo").textContent.toLowerCase();
                const grupo = formsData.find(f => f.ID_Formulario == card.dataset.formId)?.Grupo || "";

                let visible = true;

                if (!titulo.includes(searchTerm)) {
                    visible = false;
                }

                if (grupoSeleccionado !== "all" && grupo !== grupoSeleccionado) {
                    visible = false;
                }

                card.style.display = visible ? "block" : "none";
            });
        }
        let onboardingModalFormularios; 

        document.addEventListener("DOMContentLoaded", function() {
            
            const modalElement = document.getElementById('onboardingModalFormularios');
            if (!modalElement) return;

            // 2. Creamos la instancia del modal
            onboardingModalFormularios = new bootstrap.Modal(modalElement);
            
            // ¡¡Usamos una clave de guardado DIFERENTE!!
            const storageKey = 'onboardingCompleto_Formularios'; 

            // 3. Lógica para mostrar automáticamente la primera vez
            const yaVioOnboarding = localStorage.getItem(storageKey);
            if (!yaVioOnboarding) {
                onboardingModalFormularios.show();
            }

            // 4. Lógica para "recordar" cuando el usuario lo cierra
            const btnComenzar = document.getElementById('btnComenzarOnboardingFormularios');
            if (btnComenzar) {
                btnComenzar.addEventListener('click', () => {
                    localStorage.setItem(storageKey, 'true');
                });
            }
            
            modalElement.addEventListener('hidden.bs.modal', () => {
                if (!localStorage.getItem(storageKey)) {
                    localStorage.setItem(storageKey, 'true');
                }
            });

            // 5. Lógica para el NUEVO botón de "reabrir"
            const btnReabrir = document.getElementById('btnReabrirOnboardingFormularios');
            if(btnReabrir) {
                btnReabrir.addEventListener('click', () => {
                    if (onboardingModalFormularios) {
                        onboardingModalFormularios.show(); // Simplemente lo mostramos
                    }
                });
            }
        });
        // === FIN CÓDIGO ONBOARDING ===
    </script>
    <div class="modal fade" id="onboardingModalFormularios" tabindex="-1" aria-labelledby="onboardingModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="onboardingModalLabel">
                        <i class="fas fa-magic me-2 text-primary"></i>
                        ¡Bienvenido/a a la Biblioteca de Formularios!
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4" style="background-color: #f8f9fa;">
                    <p class="lead text-center mb-4">Desde aquí puedes gestionar todas tus plantillas de preguntas y formularios.</p>
                    
                    <div class="onboarding-steps">
                        <div class="onboarding-step">
                            <div class="onboarding-icon">
                                <i class="fas fa-plus"></i>
                            </div>
                            <div class="onboarding-text">
                                <strong>1. Crea un nuevo formulario</strong>
                                <p>Usa el botón "<strong>+ Nuevo Formulario</strong>" para crear una nueva plantilla (ej: "Escala de Ansiedad", "Diario Emocional").</p>
                            </div>
                        </div>
                        
                        <div class="onboarding-step">
                            <div class="onboarding-icon">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <div class="onboarding-text">
                                <strong>2. Asigna preguntas</strong>
                                <p>Haz clic en un formulario de la lista. En el panel de detalles, podrás usar el botón "<strong>Asignar Preguntas</strong>" para añadir preguntas de tu biblioteca a ese formulario.</p>
                            </div>
                        </div>

                        <div class="onboarding-step">
                            <div class="onboarding-icon">
                                <i class="fas fa-filter"></i>
                            </div>
                            <div class="onboarding-text">
                                <strong>3. Filtra y organiza</strong>
                                <p>Usa los filtros de "Grupo" o la barra de búsqueda para encontrar rápidamente las plantillas que necesitas.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-primary btn-lg" data-bs-dismiss="modal" id="btnComenzarOnboardingFormularios">
                        ¡Entendido!
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
