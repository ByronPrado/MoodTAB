@model WebConTablas.Models.Formulario

<link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="center-card">
    <h2>Crear Nuevo Formulario</h2>
    @Html.ValidationSummary(true, "x", new { @class = "text-danger" })
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="formsubtitulo" asp-for="Titulo" class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" required />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="formsubtitulo" asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <input asp-for="ID_Psiquiatra" class="form-control" type="hidden" />
        </div>
        <button type="submit" class="btn btn-success">Guardar</button>
        <button asp-action="Index" class="btn btn-secondary">Cancelar</button>
        <span>@User?.Identity?.Name</span>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}