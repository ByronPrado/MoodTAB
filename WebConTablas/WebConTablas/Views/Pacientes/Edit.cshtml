@model WebConTablas.Models.Paciente

@{
    ViewData["Title"] = "Editar Paciente";
}

<link rel="stylesheet" href="@Url.Content("~/css/forms.css")" />
<link rel="stylesheet" href="@Url.Content("~/css/formulario.css")" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="main-container2">
    <div class="header-section">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="mb-2">
                    <i class="fas fa-user-edit text-primary me-3"></i>
                    Editar Paciente
                </h1>
                <p class="text-muted mb-0">Actualiza la información del paciente</p>
            </div>
            <div class="text-end">
                <i class="fas fa-user-circle fa-3x text-primary opacity-25"></i>
            </div>
        </div>
    </div>

    <div class="form-container">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-custom mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Error:</strong> Por favor corrija los errores en el formulario.
                @Html.ValidationSummary(true, "", new { @class = "mt-2 mb-0" })
            </div>
        }

        <form asp-action="Edit" method="post" id="editPatientForm">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ID_Paciente)
            
            <div class="form-section">
                <h5>
                    <i class="fas fa-id-card text-primary"></i>
                    Información Personal
                </h5>
                
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">
                            <i class="fas fa-user me-2"></i>Nombre Completo
                        </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre completo del paciente" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label asp-for="Edad" class="form-label fw-semibold">
                            <i class="fas fa-calendar-alt me-2"></i>Edad
                        </label>
                        <input asp-for="Edad" type="number" class="form-control" placeholder="Edad del paciente" min="0" max="150" />
                        <span asp-validation-for="Edad" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Sexo" class="form-label fw-semibold">
                            <i class="fas fa-venus-mars me-2"></i>Sexo
                        </label>
                        <select asp-for="Sexo" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="M">Masculino</option>
                            <option value="F">Femenino</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Sexo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h5>
                    <i class="fas fa-address-book text-primary"></i>
                    Información de Contacto
                </h5>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">
                            <i class="fas fa-envelope me-2"></i>Correo Electrónico
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">
                            <i class="fas fa-phone me-2"></i>Teléfono
                        </label>
                        <input asp-for="Telefono" class="form-control" placeholder="Número de teléfono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h5>
                    <i class="fas fa-notes-medical text-primary"></i>
                    Información Clínica
                </h5>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Diagnostico" class="form-label fw-semibold">
                            <i class="fas fa-stethoscope me-2"></i>Diagnóstico
                            <span class="text-muted fw-normal">(opcional)</span>
                        </label>
                        <select asp-for="Diagnostico" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="Ansiedad">Ansiedad</option>
                            <option value="TDA">TDA</option>
                            <option value="Depresión">Depresión</option>
                            <option value="Manía">Manía</option>
                        </select>
                        <span asp-validation-for="Diagnostico" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Severidad" class="form-label fw-semibold">
                            <i class="fas fa-exclamation-circle me-2"></i>Severidad
                            <span class="text-muted fw-normal">(opcional)</span>
                        </label>
                        <select asp-for="Severidad" class="form-select">
                            <option value="">Seleccione...</option>
                            <option value="Leve">Leve</option>
                            <option value="Moderada">Moderada</option>
                            <option value="Severa">Severa</option>
                        </select>
                        <span asp-validation-for="Severidad" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('editPatientForm');
        const inputs = form.querySelectorAll('.form-control, .form-select');
        
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });
            
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('focused');
                if (this.value.trim() !== '') {
                    this.classList.add('has-value');
                } else {
                    this.classList.remove('has-value');
                }
            });
        });
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
