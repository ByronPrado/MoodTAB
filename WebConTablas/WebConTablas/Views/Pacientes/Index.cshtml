@model IEnumerable<WebConTablas.Models.Paciente>
@using System.Text.Json
@using System.Collections.Generic

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/luxon@3.5.0/build/global/luxon.min.js"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/paginas.css")" />
    
</head>
<body>
    <div class="main-container">
        
        <div class="sidebar">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0 fw-bold">Lista de Pacientes</h4>
                <a href="/Pacientes/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i> Agregar
                </a>
            </div>

            <div class="search-box">
                <input type="text" class="form-control" placeholder="Buscar pacientes..." id="searchInput" onkeyup="filtrar()">
                <i class="fas fa-search"></i>
            </div>

            
            <div class="mb-3">
                <label for="diagnostico" class="form-label">Diagnóstico</label>
                <select name="diagnostico" id="filtro-diagnostico" class="form-select">
                    <option value="none">Todos los diagnósticos</option>
                    <option value="Ansiedad">Ansiedad</option>
                    <option value="TDA">TDA</option>
                    <option value="Depresión">Depresión</option>
                    <option value="Manía">Manía</option>
                </select>
            </div>
            
            <div class="form-check">
                <input type="checkbox" name="alerta" id="filtro-alerta" class="form-check-input"/>
                <label for="alerta" class="form-check-label">Mostrar solo alertas</label>
            </div>

            <div class="card-list-pacientes">
            @foreach (var paciente in Model)
            {
                var tieneAlerta = paciente.Alertas != null && paciente.Alertas.Any(a => a.Estado == "No Visto");
                
                <div class="white-card" data-patient-id="@paciente.ID_Paciente" onclick="showPatientDetails(@paciente.ID_Paciente)">
                    <div class="d-flex align-items-start mb-2">
                        <div class="flex-grow-1">
                            <h6 class="mb-1 fw-semibold" id="paciente-nombre">@paciente.Nombre</h6>
                            <span id="paciente-diagnostico" class="condition-badge condition-@paciente.Diagnostico?.ToLower()">
                                @paciente.Diagnostico
                            </span>
                        </div>
                        @if (tieneAlerta)
                        {
                            <span class="badge bg-warning" id="alerta">
                                <i class="fas fa-exclamation-triangle me-1"></i>Alerta
                            </span>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2" style="border-top: 1px solid var(--border-color);">
                        <span class="text-muted small">
                            <i class="fas fa-clipboard-list me-1"></i>@(paciente.FormulariosAsignados?.Count() ?? 0) Cuestionarios
                        </span>
                        <span class="text-muted small">
                            <i class="fas fa-heart me-1"></i>@(paciente.DiariosEmocionales?.Count() ?? 0) Diarios
                        </span>
                    </div>
                </div>
            }
            </div>
        </div>


        <div class="content-panel">
            <div id="patient-details">
                <div class="detail-card">
                    <div class="no-data-state">
                        <i class="fas fa-user-circle"></i>
                        <h5>Selecciona un paciente</h5>
                        <p>Haz clic en un paciente de la lista para ver sus detalles completos</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script>
    @{
        string jsonEjemplo = @"{
            ""SenalesAlerta"": [""Sentirme muy ansioso/a"", ""Ganas de llorar sin razón"", ""Pensamientos de que no valgo nada""],
            ""EstrategiasInternas"": [""Respirar profundo 10 veces"", ""Escuchar música relajante"", ""Salir a caminar 15 minutos""],
            ""PersonasDistraerme"": [
                { ""Nombre"": ""Ana (Amiga)"", ""Fono"": ""+56 9 1111 2222"" },
                { ""Nombre"": ""Mamá"", ""Fono"": ""+56 9 3333 4444"" }
            ],
            ""PersonasPedirAyuda"": [
                { ""Nombre"": ""Dr. Ramírez"", ""Fono"": ""+56 9 5555 6666"" },
                { ""Nombre"": ""Hermano (Juan)"", ""Fono"": ""+56 9 7777 8888"" }
            ],
            ""Profesionales"": [
                { ""Nombre"": ""Salud Responde"", ""Fono"": ""600 360 7777"" },
                { ""Nombre"": ""Emergencia Clínica"", ""Fono"": ""2 2999 0000"" }
            ],
            ""AmbienteSeguro"": [""Despejar mi velador"", ""Guardar objetos peligrosos bajo llave""]
        }";
    }
        const patientsData = @Html.Raw(JsonSerializer.Serialize(Model.Select(p => new {
            ID_Paciente = p.ID_Paciente,
            Nombre = p.Nombre,
            Edad = p.Edad,
            Sexo = p.Sexo,
            Email = p.Email,
            Telefono = p.Telefono,
            Diagnostico = p.Diagnostico,
            Severidad = p.Severidad,
            //----------------------Prueba plan seguro---------------------------------------------------
            //PlanSeguro = p.PlanSeguro,
            PlanSeguro = p.Nombre == "Ana Gómez" ? jsonEjemplo : p.PlanSeguro,
            //-------------------------------------------------------------------------------------------
            TieneAlerta = p.Alertas != null && p.Alertas.Any(a => a.Estado == "No Visto"),
            Alertas = p.Alertas?.Where(a => a.Estado == "No Visto").Select(a => new {
                ID_Alerta = a.ID_Alerta,
                ID_Paciente = a.ID_Paciente,
                Contenido = a.Contenido ?? "Sin descripción",
                Tipo = a.Tipo ?? "Alerta",
                Created_at = a.Created_at?.ToString("dd/MM/yyyy HH:mm") ?? "Fecha desconocida"
            }).ToList(),
            DiariosEmocionales = p.DiariosEmocionales?.Select(d => new {
                Fecha = d.Fecha.ToString("yyyy-MM-dd"),
                Emociones = d.Emociones,
                Descripcion = d.Descripcion,
                Pasos = d.Pasos,
                Horas_celular = d.Horas_celular,
                Horas_redes = d.Horas_redes,
                Hora_dormida = d.Hora_dormida,
                Estado = d.Estado
            }).ToList(),
            FormulariosAsignados = p.FormulariosAsignados?.Select(f => new {
                IdForm = f.ID_Asignacion,
                Estado = f.Estado,
                Fecha_Asignacion = f.Fecha_Asignacion.ToString("yyyy-MM-dd"),
                Titulo = f.Formulario?.Titulo ?? "Evaluación inicial",
                Respuestas = f.Respuestas?.Select(r => new {
                    PreguntaContenido = r.Pregunta?.Contenido ?? "Pregunta no disponible",
                    Contenido = r.Contenido,
                    Fecha_Respuesta = r.Fecha_Respuesta?.ToString("yyyy-MM-dd")
                }).ToList()
            }).ToList(),
            UsuariosExternos = p.UsuariosExternos?.Select(u => new {
                IdUsuarioExterno = u.IdUsuarioExterno,
                Nombre = u.Nombre,
                Parentezco = u.Parentezco,
                Email = u.Email,
                UltimoComentario = u.Comentarios?.OrderByDescending(c => c.Fecha).FirstOrDefault()?.Fecha.ToString("yyyy-MM-dd"),
                Comentarios = u.Comentarios?.Select(c => new {
                    Fecha = c.Fecha.ToString("g"),
                    Comentario = c.Comentario
                }).OrderByDescending(c => c.Fecha).ToList()
            }).ToList()
        })));

        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || 
                                '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1];
        function initDetailToggles() {
            document.querySelectorAll("details[data-section]").forEach(detail => {
                const key = detail.dataset.section;
                const savedState = localStorage.getItem("detail-" + key);

                if (savedState === "open") {
                    detail.setAttribute("open", "true");
                } else {
                    detail.removeAttribute("open");
                }

                detail.addEventListener("toggle", () => {
                    localStorage.setItem("detail-" + key, detail.open ? "open" : "closed");
                });
            });
        }   
        function showPatientDetails(patientId) {
            // Remove active class from all cards
            document.querySelectorAll('.white-card').forEach(card => {
                card.classList.remove('active');
            });
            
            // Add active class to clicked card
            const clickedCard = document.querySelector(`[data-patient-id="${patientId}"]`);
            if (clickedCard) {
                clickedCard.classList.add('active');
            }
            
            // Find patient data
            const patient = patientsData.find(p => p.ID_Paciente === patientId);
            if (!patient) return;
            
            // Update patient details content
            const detailsContainer = document.getElementById('patient-details');
            detailsContainer.innerHTML = generatePatientDetailsHTML(patient);
            initDetailToggles();
        }

        function generatePatientDetailsHTML(patient) {
            const diagnosticoClass = patient.Diagnostico ? patient.Diagnostico.toLowerCase() : '';
            
            let alertBannerHTML = '';
            if (patient.TieneAlerta && patient.Alertas && patient.Alertas.length > 0) {
                const alertasHTML = patient.Alertas.map(alerta => `
                    <div class="alert-item" data-alertaP-id="${alerta.ID_Alerta}">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <span class="badge bg-warning text-dark me-2">${alerta.Tipo}</span>
                                <span>${alerta.Contenido}</span>
                                <a href="/Pacientes/Details/${alerta.ID_Paciente.toString()}" class="btn btn-sm btn-outline-primary">
                                    Detalles
                                </a>
                                <small class="text-muted ms-2">${alerta.Created_at}</small>
                            </div>
                            <div class="alert-actions">
                                <button class="btn btn-sm btn-success me-2" onclick="handleAlertAction(${alerta.ID_Alerta}, 'Visto', event)">
                                    <i class="fas fa-check me-1"></i>Ok
                                </button>
                                <button class="btn btn-sm btn-secondary" onclick="handleAlertAction(${alerta.ID_Alerta}, 'Ignorado', event)">
                                    <i class="fas fa-times me-1"></i>Ignorar
                                </button>
                            </div>
                        </div>
                    </div>
                `).join('');
                
                alertBannerHTML = `
                    <div class="alert-banner" id="alert-banner-${patient.ID_Paciente}">
                        <div class="alert-banner-content">
                            <div class="alert-banner-icon">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="alert-banner-text">
                                <h6 class="mb-2">Alertas Activas</h6>
                                ${alertasHTML}
                            </div>
                        </div>
                    </div>
                `;
            }
            
            let diariosHTML = '';
            if (patient.DiariosEmocionales && patient.DiariosEmocionales.length > 0) {
                const diariosOrdenados = [...patient.DiariosEmocionales];
                                
                const diarioReciente = diariosOrdenados.at(-1);
                const emociones = diarioReciente.Emociones.split(',');
                const respuestas = diarioReciente.Descripcion.split('/');
                
                const fecha = new Date(diarioReciente.Fecha).toLocaleDateString('es-ES', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                
                diariosHTML = `
                    <div class="emotion-entry">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="fw-semibold text-primary">
                                ${fecha}
                            </span>
                            <span class="condition-badge condition-${diarioReciente.Estado}">
                                <strong>${diarioReciente.Estado || 'basal'}</strong>
                            </span>
                            
                        </div>
                        
                        <div class="mb-3">
                            <p class="fw-medium mb-2 text-secondary">¿Cómo han estado tus pensamientos?</p>
                            <p class="mb-0 ps-3 border-start border-3 border-primary">"${respuestas[0]}"</p>
                        </div>
                        
                        <div class="mb-3">
                            <p class="fw-medium mb-2 text-secondary">¿Algo que consideres importante de tu día?</p>
                            <p class="mb-0 ps-3 border-start border-3 border-primary">"${respuestas[1]}"</p>
                        </div>
                        
                        <div class="mb-3">
                            <p class="fw-medium mb-2 text-secondary">¿Algo más que quieras contar?</p>
                            <p class="mb-0 ps-3 border-start border-3 border-primary">"${respuestas[2]}"</p>
                        </div>
                        
                        <div class="metrics-grid">
                            <div class="metric-item">
                                <i class="fas fa-smile text-success"></i>
                                <span>Ánimo: <strong>${emociones[0]}/10</strong></span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-utensils text-warning"></i>
                                <span>Apetito: <strong>${emociones[1]}/10</strong></span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-bolt text-danger"></i>
                                <span>Energía: <strong>${emociones[2]}/10</strong></span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-bed text-info"></i>
                                <span>Sueño: <strong>${emociones[3]}/10</strong></span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-users text-primary"></i>
                                <span>Social: <strong>${emociones[4]}/10</strong></span>
                            </div>
                        </div>
                        
                        <div class="metrics-grid mt-3">
                            <div class="metric-item">
                                <i class="fas fa-walking text-success"></i>
                                <span><strong>${diarioReciente.Pasos || 0}</strong> pasos</span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-mobile-alt text-primary"></i>
                                <span><strong>${diarioReciente.Horas_celular || 0}h</strong> celular</span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-share-alt text-info"></i>
                                <span><strong>${diarioReciente.Horas_redes || 0}h</strong> redes</span>
                            </div>
                            <div class="metric-item">
                                <i class="fas fa-moon text-warning"></i>
                                <span><strong>${diarioReciente.Hora_dormida || 'N/A'}h</strong> dormidas</span>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                diariosHTML = `
                    <div class="no-data-state">
                        <i class="fas fa-heart"></i>
                        <p>No hay diarios emocionales registrados</p>
                    </div>
                `;
            }

            let formulariosHTML = '';
            if (patient.FormulariosAsignados && patient.FormulariosAsignados.length > 0) {
                formulariosHTML = patient.FormulariosAsignados.map(formulario => {
                    const isCompleted = formulario.Estado === 'Listo';
                    const fecha = new Date(formulario.Fecha_Asignacion).toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                    
                    let respuestasHTML = '';
                    if (isCompleted && formulario.Respuestas && formulario.Respuestas.length > 0) {
                        respuestasHTML = `
                            <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-color);">
                                <h6 class="text-secondary mb-3 fw-semibold">
                                    <i class="fas fa-clipboard-check me-2"></i>Respuestas:
                                </h6>
                                <ul class="list-unstyled ms-3">
                                    ${formulario.Respuestas.map(respuesta => `
                                        <li class="mb-3">
                                            <strong class="text-dark d-block mb-1">${respuesta.PreguntaContenido}</strong>
                                            <div class="text-muted ps-3 border-start border-2 border-primary">${respuesta.Contenido}</div>
                                        </li>
                                    `).join('')}
                                </ul>
                            </div>
                        `;
                    }
                    
                    return `
                        <div class="form-status-card ${isCompleted ? 'form-completado' : 'form-pendiente'}">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas ${isCompleted ? 'fa-check-circle text-success' : 'fa-clock text-warning'} me-2"></i>
                                        <strong class="fs-6">${formulario.Titulo}</strong>
                                    </div>
                                    <div class="text-muted small mb-2">
                                        <i class="fas fa-calendar me-1"></i>Creado: ${fecha}
                                    </div>
                                    <form action="/FormulariosAsignados/Delete" method="post" style="display:inline;" onsubmit="return confirm('¿Seguro que deseas eliminar esta asignación?');">
                                        <input type="hidden" name="__RequestVerificationToken" value="${antiForgeryToken}" />
                                        <input type="hidden" name="id" value="${formulario.IdForm}" />
                                        <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 border-0 bg-transparent small">
                                            <i class="fas fa-trash-alt me-1"></i>Eliminar asignación
                                        </button>
                                    </form>
                                    ${respuestasHTML}
                                </div>
                                <span class="badge ${isCompleted ? 'bg-success' : 'bg-warning'} ms-2">
                                    ${isCompleted ? 'Completado' : 'Pendiente'}
                                </span>
                            </div>
                        </div>
                    `;
                }).join('');
            } else {
                formulariosHTML = `
                    <div class="no-data-state">
                        <i class="fas fa-clipboard-list"></i>
                        <p>No hay formularios asignados</p>
                    </div>
                `;
            }

            let usuariosHTML = '';
            if (patient.UsuariosExternos && patient.UsuariosExternos.length > 0) {
                usuariosHTML = patient.UsuariosExternos.map(usuario => {
                    const collapseId = `collapseComentarios_${usuario.IdUsuarioExterno}`;
                    const ultimoComentario = usuario.UltimoComentario ? 
                        `<div class="mt-2"><small class="text-muted">
                            <i class="fas fa-comment-dots me-1"></i>Último comentario: ${new Date(usuario.UltimoComentario).toLocaleDateString('es-ES')}
                        </small></div>` : '';
                    
                    let comentariosHTML = '';
                    if (usuario.Comentarios && usuario.Comentarios.length > 0) {
                        comentariosHTML = usuario.Comentarios.map(comentario => `
                            <li class="list-group-item border-0 bg-light mb-2 rounded">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="fas fa-comment text-primary mt-1"></i>
                                    <div class="flex-grow-1">
                                        <strong class="d-block mb-1">${comentario.Fecha}</strong>
                                        <p class="mb-0">${comentario.Comentario}</p>
                                    </div>
                                </div>
                            </li>
                        `).join('');
                        comentariosHTML = `<ul class="list-group">${comentariosHTML}</ul>`;
                    } else {
                        comentariosHTML = '<div class="text-center py-3"><span class="text-muted">No hay comentarios registrados.</span></div>';
                    }
                    
                    return `
                        <div class="external-user-card">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div>
                                        <h6 class="mb-0 fw-semibold">${usuario.Nombre}</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-user-tag me-1"></i>${usuario.Parentezco}
                                        </small>
                                        ${ultimoComentario}
                                    </div>
                                </div>
                                <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" 
                                        data-bs-target="#${collapseId}" aria-expanded="false" aria-controls="${collapseId}">
                                    <i class="fas fa-comments me-1"></i>Ver comentarios
                                </button>
                            </div>
                            <div class="collapse mt-3" id="${collapseId}">
                                ${comentariosHTML}
                            </div>
                        </div>
                    `;
                }).join('');
            } else {
                usuariosHTML = `
                    <div class="no-data-state">
                        <i class="fas fa-users"></i>
                        <p>No hay usuarios externos registrados</p>
                    </div>
                `;
            }

            
            return `
                ${alertBannerHTML}
                <div class="info-grid">
                    <div class="detail-card-p info-paciente">
                        <div class="d-flex align-items-start justify-content-between mb-4">
                            <div class="flex-grow-1">
                                <h2 class="mb-2 fw-bold">${patient.Nombre}</h2>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="datos-paciente">
                                    <i class="fas fa-birthday-cake text-primary"></i>
                                    <span><strong>${patient.Edad}</strong> años</span>
                                </div>
                                <div class="datos-paciente">
                                    <i class="fas fa-venus-mars text-primary"></i>
                                    <span>${patient.Sexo}</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="datos-paciente">
                                    <i class="fas fa-envelope text-primary"></i>
                                    <span>${patient.Email}</span>
                                </div>
                                <div class="datos-paciente">
                                    <i class="fas fa-phone text-primary"></i>
                                    <span>${patient.Telefono}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="info-diagnostico detail-card-p">
                        <h6>Diagnóstico General</h6>
                        <span class="condition-badge condition-${diagnosticoClass}">
                           ${patient.Diagnostico || 'Sin diagnóstico'}
                        </span>
                        <br><br>
                        <small>
                        Fecha del Diagnóstico
                        </small>
                        <p>15 / 10 / 2023</p>
                        <small>Severidad</small>
                        <p>${(patient.Severidad == "Leve") ? "⭐" : (patient.Severidad == "Moderada" ? "⭐⭐" : "⭐⭐⭐")} ${patient.Severidad}</p>
                        <a href="/Pacientes/Edit/${patient.ID_Paciente}" class="btn btn-sm btn-outline-primary mt-3">
                            <i class="fas fa-edit me-1"></i>Editar Información
                        </a>
                    </div>
                </div>
                
                <details class="detail-card" data-section="diarios-${patient.ID_Paciente}">
                    <summary class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 summary-title">
                            <i class="fas fa-calendar-day me-2 text-primary"></i></i>Diario emocional reciente
                        </h5>
                        <a href="/Pacientes/Details/${patient.ID_Paciente.toString()}" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-external-link-alt me-1"></i>Ver todos
                        </a>
                    </summary>
                    <div class="mt-3">
                        ${diariosHTML}
                    </div>
                </details>

                <details class="detail-card" data-section="formularios-${patient.ID_Paciente}">
                    <summary class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 summary-title">
                            <i class="fas fa-clipboard-list me-2 text-primary"></i>Formularios asignados
                        </h5>
                        <a href="/FormulariosAsignados/Asignar" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-plus me-1"></i>Asignar formulario
                        </a>
                    </summary>
                    <div class="mt-3">
                        ${formulariosHTML}
                    </div>
                </details>

                <details class="detail-card" data-section="comentarios-${patient.ID_Paciente}">
                    <summary class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 summary-title">
                            <i class="fas fa-user-friends me-2 text-primary"></i>Usuarios externos
                        </h5>
                    </summary>
                    <div class="mt-3">
                        ${usuariosHTML}
                    </div>
                </details>

                <details class="detail-card" data-section="plan-seguridad-${patient.ID_Paciente}">
                    <summary class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 summary-title">
                            <i class="fas fa-shield-alt me-2 text-primary"></i>Plan de Seguridad
                        </h5>
                        <button typebutton="button" class="btn btn-sm btn-outline-primary" onclick="event.preventDefault(); printSafetyPlan(${patient.ID_Paciente})">
                            <i class="fas fa-print me-1"></i>Imprimir Plan
                        </button>
                        </summary>
                    <div class="mt-3">
                        ${generateSafetyPlanHTML(patient.PlanSeguro)}
                    </div>
                </details>
            `;
        }

        // prueba para plan seguro -----------------------------------

        function generateSafetyPlanHTML(planSeguroJson) {
            if (!planSeguroJson || planSeguroJson.trim() === "") {
                return `
                    <div class="no-data-state">
                        <i class="fas fa-shield-alt"></i>
                        <p>No hay un plan de seguridad registrado para este paciente.</p>
                    </div>
                `;
            }

            try {
                const plan = JSON.parse(planSeguroJson);

                // Funciones auxiliares para crear las listas
                const createStringList = (items, icono) => {
                    if (!items || items.length === 0) return '<li>No hay elementos.</li>';
                    return items.map(item => `<li><i class="${icono} me-2 text-muted"></i>${item || 'N/A'}</li>`).join('');
                };

                const createContactList = (items, icono) => {
                    if (!items || items.length === 0) return '<li>No hay elementos.</li>';
                    return items.map(contacto => `
                        <li class="d-flex justify-content-between">
                            <span><i class="${icono} me-2 text-muted"></i>${contacto.Nombre || 'N/A'}</span>
                            <span class="text-muted">${contacto.Fono || ''}</span>
                        </li>
                    `).join('');
                };

                return `
                    <div class="safety-plan-container">
                        <h6 class="text-secondary fw-semibold"><i class="fas fa-exclamation-circle me-2"></i>Paso 1: Señales de alerta</h6>
                        <ul class="list-unstyled ms-3 mb-4">
                            ${createStringList(plan.SenalesAlerta, 'fa-solid fa-flag')}
                        </ul>

                        <h6 class="text-secondary fw-semibold"><i class="fas fa-street-view me-2"></i>Paso 2: Estrategias internas</h6>
                        <ul class="list-unstyled ms-3 mb-4">
                            ${createStringList(plan.EstrategiasInternas, 'fa-solid fa-check')}
                        </ul>

                        <h6 class="text-secondary fw-semibold"><i class="fas fa-users me-2"></i>Paso 3: Personas o situaciones que me ayudan</h6>
                        <ul class="list-unstyled ms-3 mb-4">
                            ${createContactList(plan.PersonasDistraerme, 'fa-solid fa-user')}
                        </ul>

                        <h6 class="text-secondary fw-semibold"><i class="fas fa-phone-alt me-2"></i>Paso 4: Personas a las que puedo pedir ayuda</h6>
                        <ul class="list-unstyled ms-3 mb-4">
                            ${createContactList(plan.PersonasPedirAyuda, 'fa-solid fa-user-shield')}
                        </ul>

                        <h6 class="text-secondary fw-semibold"><i class="fas fa-hospital me-2"></i>Paso 5: Profesionales o instituciones</h6>
                        <ul class="list-unstyled ms-3 mb-4">
                            ${createContactList(plan.Profesionales, 'fa-solid fa-user-md')}
                            </ul>

                        <h6 class="text-secondary fw-semibold"><i class="fas fa-home me-2"></i>Vivir en un ambiente seguro</h6>
                        <ul class="list-unstyled ms-3 mb-4">
                            ${createStringList(plan.AmbienteSeguro, 'fa-solid fa-key')}
                        </ul>
                    </div>
                `;
            } catch (e) {
                console.error("Error al parsear PlanSeguro JSON:", e, planSeguroJson);
                return `<div class="alert alert-danger">Error al cargar el plan de seguridad.</div>`;
            }
        }

        async function printSafetyPlan(patientId) {
            // 1. Encontrar los datos del paciente
            const patient = patientsData.find(p => p.ID_Paciente === patientId);
            if (!patient) {
                alert("No se encontró al paciente.");
                return;
            }

            // 2. Encontrar el elemento HTML del plan de seguridad
            // Usamos la clase .safety-plan-container que definimos en generateSafetyPlanHTML
            const planElement = document.querySelector(`[data-section="plan-seguridad-${patientId}"] .safety-plan-container`);

            if (!planElement) {
                // Comprobar si es porque no tiene plan
                const noDataElement = document.querySelector(`[data-section="plan-seguridad-${patientId}"] .no-data-state`);
                if(noDataElement) {
                    alert("No hay un plan de seguridad para imprimir.");
                } else {
                    alert("No se pudo encontrar el elemento del plan de seguridad.");
                }
                return;
            }

            // 3. Usar html2canvas y jsPDF (similar a Details.cshtml)
            try {
                const { jsPDF } = window.jspdf;
                const canvas = await html2canvas(planElement, { scale: 2 });
                const imgData = canvas.toDataURL('image/png');
                
                // Configurar el documento PDF en A4
                const doc = new jsPDF({
                    orientation: 'p',
                    unit: 'mm',
                    format: 'a4'
                });

                const margin = 15;
                const topMargin = 25;
                const pdfWidth = doc.internal.pageSize.getWidth();
                const pageWidth = pdfWidth - (margin * 2);
                const pdfHeight = doc.internal.pageSize.getHeight();
                const pageHeight = pdfHeight - (topMargin * 2);

                // Calcular el alto de la imagen manteniendo la proporción
                const imgProps = doc.getImageProperties(imgData);
                const imgHeight = (imgProps.height * pageWidth) / imgProps.width;

                // Añadir Título
                doc.setFontSize(18);
                doc.text(`Plan de Seguridad de: ${patient.Nombre}`, pdfWidth / 2, margin, { align: 'center' });

                // Escalar la imagen si es más alta que la página
                let finalImgHeight = imgHeight;
                if (imgHeight > pageHeight) {
                    finalImgHeight = pageHeight;
                    console.warn("El plan de seguridad excede una página, puede verse recortado.");
                }

                // Añadir la imagen del plan
                doc.addImage(imgData, 'PNG', margin, topMargin, pageWidth, finalImgHeight);
                
                // 4. Guardar el PDF
                const fecha = new Date().toISOString().slice(0, 10);
                doc.save(`PlanSeguridad-${patient.Nombre.replace(/ /g, "_")}-${fecha}.pdf`);

            } catch (err) {
                console.error("Error al generar el PDF del plan:", err);
                alert("Hubo un error al generar el PDF.");
            }
        }
        //------------------------------------------------------------
        function filtrar(){
            const questionCards = document.querySelectorAll('.white-card');
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const diagnostico = document.getElementById('filtro-diagnostico').value;
            const alerta = document.getElementById('filtro-alerta').checked;
            questionCards.forEach(card => {
                let shouldShow = true;
                
                const nombreElement = card.querySelector("#paciente-nombre");
                if (nombreElement && !nombreElement.textContent.toLowerCase().includes(searchTerm)) {
                    shouldShow = false;
                }
                if (diagnostico !== "none") {
                    const diagnosticoElement = card.querySelector("#paciente-diagnostico");
                    if (diagnosticoElement && diagnosticoElement.textContent.trim() !== diagnostico) {
                        shouldShow = false;
                    }
                }
                if (alerta) {
                    const alertaElement = card.querySelector("#alerta");
                    if (!alertaElement) {
                        shouldShow = false;
                    }
                }
                
                // Apply visibility
                card.style.display = shouldShow ? 'block' : 'none';
            });
        }

        const selectDiagnostico = document.getElementById("filtro-diagnostico");
        const checkboxalerta = document.getElementById("filtro-alerta");
        selectDiagnostico.addEventListener("change", filtrar);
        checkboxalerta.addEventListener("change", filtrar);

        async function handleAlertAction(alertaId, estado, event) {
            event.stopPropagation();
            
            try {
                const response = await fetch('/Pacientes/ActualizarEstadoAlerta', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ 
                        idAlerta: alertaId, 
                        estado: estado 
                    })
                });
                
                if (response.ok) {
                    
                    // Remove the alert item from the banner
                    const alertItem = document.querySelector(`[data-alertaP-id="${alertaId}"]`);
                    const alertItemnotif = document.querySelector(`[data-alerta-id="${alertaId}"]`);
                    if (alertItemnotif) {
                        alertItemnotif.style.transition = 'opacity 0.3s ease';
                        alertItemnotif.style.opacity = '0';
                        alertItemnotif.remove();
                    }
                    if (alertItem) {
                        alertItem.style.transition = 'opacity 0.3s ease';
                        alertItem.style.opacity = '0';
                        setTimeout(() => {
                            alertItem.remove();
                            
                            // Check if there are any remaining alerts
                            const remainingAlerts = document.querySelectorAll('.alert-item');
                            
                            if (remainingAlerts.length === 0) {
                                // Hide the entire banner if no alerts remain
                                const banner = document.querySelector('.alert-banner');
                                if (banner) {
                                    banner.style.transition = 'all 0.3s ease';
                                    banner.style.opacity = '0';
                                    banner.style.maxHeight = '0';
                                    setTimeout(() => banner.remove(), 150);
                                }
                            }
                        }, 150);
                    }
                    
                    // Update notification count in navbar
                    const notifBadge = document.getElementById('notif-count-badge');
                    if (notifBadge) {
                        const currentCount = parseInt(notifBadge.textContent);
                        const newCount = currentCount - 1;
                        console.log("[v0] Updating notification count:", currentCount, "->", newCount);
                        
                        if (newCount > 0) {
                            notifBadge.textContent = newCount;
                        } else {
                            notifBadge.remove();
                        }
                    }
                    
                    // Update the patient data
                    const patient = patientsData.find(p => p.Alertas && p.Alertas.some(a => a.ID_Alerta === alertaId));
                    if (patient) {
                        patient.Alertas = patient.Alertas.filter(a => a.ID_Alerta !== alertaId);
                        patient.TieneAlerta = patient.Alertas.length > 0;
                        
                        console.log("[v0] Updated patient data:", { 
                            patientId: patient.ID_Paciente, 
                            remainingAlerts: patient.Alertas.length 
                        });
                        
                        // Update the alert badge in the sidebar
                        const patientCard = document.querySelector(`[data-patient-id="${patient.ID_Paciente}"]`);
                        if (patientCard && !patient.TieneAlerta) {
                            const alertBadge = patientCard.querySelector('#alerta');
                            if (alertBadge) {
                                alertBadge.remove();
                            }
                        }

                    }
                } else {
                    console.error("[v0] Failed to update alert. Status:", response.status);
                    const errorData = await response.json();
                    console.error("[v0] Error details:", errorData);
                }
            } catch (error) {
                console.error('[v0] Error updating alert status:', error);
            }
        }
    </script>
    @Html.AntiForgeryToken()
</body>
</html>
