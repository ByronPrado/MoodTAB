@model IEnumerable<WebConTablas.Models.Paciente>
@using System.Text.Json
@using System.Collections.Generic

<h2>Pacientes</h2>
<a href="/Pacientes/Create" class="btn btn-primary mb-3">Agregar Paciente</a>

<table class="table table-striped">
    <thead>
        <tr><th>Id</th><th>Nombre Completo</th><th>Preguntas</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ID_Paciente</td>
                <td>@c.Nombre</td>
                <td></td>
                <td>
                    <a href="/Pacientes/Edit/@c.ID_Paciente" class="btn btn-warning btn-sm">Editar</a>
                    <a href="/Pacientes/Delete/@c.ID_Paciente" class="btn btn-danger btn-sm"
                       onclick="return confirm('¿Seguro que quieres borrar este paciente?');">Borrar</a>
                    <a href="/Pacientes/Details/@c.ID_Paciente" class="btn btn-info btn-sm">Ver Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@foreach(var p in Model)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@p.Nombre</strong> (ID: @p.ID_Paciente) - @p.Diagnostico
        </div>
        <div class="card-body">
            <p><b>Edad:</b> @p.Edad | <b>Sexo:</b> @p.Sexo | <b>Email:</b> @p.Email | <b>Teléfono:</b> @p.Telefono</p>
            <h5>Diarios emocionales</h5>
            @if (p.DiariosEmocionales != null && p.DiariosEmocionales.Any())
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Emociones</th>
                            <th>Descripción</th>
                            <th>Pasos</th>
                            <th>Horas Celular</th>
                            <th>Horas Redes</th>
                            <th>Hora Dormida</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var d in p.DiariosEmocionales)
                        {
                            <tr>
                                <td>@d.Fecha.ToShortDateString()</td>
                                @{
                                    var emocionesDict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(d.Emociones);
                                }
                                <td>@string.Join(", ", emocionesDict.Keys)</td>
                                <td>@d.Descripcion</td>
                                <td>@d.Pasos</td>
                                <td>@d.Horas_celular</td>
                                <td>@d.Horas_redes</td>
                                <td>@d.Hora_dormida</td>
                                <td>
                                    <span class="badge 
                                        @(d.Estado == "exaltado" ? "bg-success" : d.Estado == "inhibido" ? "bg-danger" : "bg-secondary")">
                                        @d.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No hay diarios emocionales registrados.</p>
            }
            <h5>Formularios respondidos</h5>
            <ul>
            @foreach (var fa in p.FormulariosAsignados)
            {
                <li>
                    <b>@fa.Formulario?.Titulo</b> (@fa.Estado) - Asignado: @fa.Fecha_Asignacion.ToShortDateString()

                    @if (fa.Estado == "Listo" && fa.Respuestas.Any())
                    {
                        <ul>
                            @foreach (var r in fa.Respuestas)
                            {
                                <li><b>@r.Pregunta?.Contenido:</b> @r.Contenido</li>
                            }
                        </ul>
                    }
                </li>
            }
            </ul>
            <h5>Usuarios Externos</h5>
            @if (p.UsuariosExternos != null && p.UsuariosExternos.Any())
            {
                <ul class="list-group mb-3">
                @foreach (var ue in p.UsuariosExternos)
                {
                    var collapseId = $"collapseComentarios_{ue.IdUsuarioExterno}";
                    <li class="list-group-item">
                        <b>@ue.Nombre</b> (@ue.Parentezco) - <span class="text-muted">@ue.Email</span>
                        <button class="btn btn-link btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            Ver comentarios
                        </button>
                        <div class="collapse mt-2" id="@collapseId">
                            @if (ue.Comentarios != null && ue.Comentarios.Any())
                            {
                                <ul class="list-group">
                                @foreach (var cmt in ue.Comentarios.OrderByDescending(c => c.Fecha))
                                {
                                    <li class="list-group-item">
                                        <b>@cmt.Fecha.ToString("g"):</b> @cmt.Comentario
                                    </li>
                                }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted">No hay comentarios registrados.</span>
                            }
                        </div>
                    </li>
                }
                </ul>
            }
            else
            {
                <p class="text-muted">No hay usuarios externos asociados.</p>
            }
        </div>
    </div>
}