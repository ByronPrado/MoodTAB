<!DOCTYPE html>
@using Microsoft.AspNetCore.Http
<html>
<head>
    <meta charset="utf-8" />
    <title>MoodTAB</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/navbar.css")" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    @if (currentAction != "Login")
    {
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Psiquiatras" asp-action="Details"><img style="height : 30px;" src="@Url.Content("~/moodtablogo_white.svg")"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Pacientes" asp-action="Index">Pacientes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Formularios" asp-action="Index">Formularios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Preguntas" asp-action="Index">Preguntas</a>
                    </li>
                </ul>
                @{
                    var psiquiatraNombre = Context.Session.GetString("PsiquiatraNombre");
                }
                <ul class="navbar-nav ms-auto">
                @if (!string.IsNullOrEmpty(psiquiatraNombre))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Psiquiatras" asp-action="Details" title="Mi Agenda">
                                @psiquiatraNombre
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <form class="form-inline" asp-controller="Psiquiatras" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link btn btn-link text-light">Cerrar Sesión</button>
                            </form>
                        </li>
                    }
                </ul>

                @if (currentController == "Pacientes" && currentAction == "Index")
                {
                    <div class="ms-auto d-flex align-items-center">
                        <button id="notifBtn" class="btn position-relative" type="button" data-bs-toggle="modal" data-bs-target="#notifModal">
                            <img src="@Url.Content("~/notif.svg")" alt="Notificaciones" style="height: 24px;">
                            @* Add null check for alerts count *@
                            @{
                                var alertasNoVistas = ViewBag.AlertasNoVistas as List<WebConTablas.Models.Alertas>;
                                var alertCount = alertasNoVistas?.Count ?? 0;
                            }
                            @if (alertCount > 0)
                            {
                                <span id="notif-count-badge" class="notif-count position-absolute badge rounded-pill bg-danger">
                                    @alertCount
                                </span>
                            }
                        </button>
                    </div>
                    <div class="modal fade" id="notifModal" tabindex="-1" aria-labelledby="notifModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-dark text-white">
                                    <h5 class="modal-title" style="color : white;" id="notifModalLabel">Notificaciones de Alertas</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                </div>
                                <div class="modal-body">
                                    @* Add null check for alerts display *@
                                    @if (alertasNoVistas != null && alertasNoVistas.Any())
                                    {
                                        <ul class="list-group">
                                            @foreach (var alerta in alertasNoVistas)
                                            {
                                                <li class="list-group-item list-group-item-action alerta-item" 
                                                    data-id="@alerta.ID_Paciente"
                                                    data-alerta-id="@alerta.ID_Alerta"
                                                    style="cursor:pointer;">
                                                    <strong>@(alerta.Paciente?.Nombre ?? "Paciente desconocido")</strong>
                                                    <span class="badge bg-warning text-dark ms-2">@(alerta.Tipo ?? "Alerta")</span>
                                                    <br />
                                                    <small class="text-muted">@(alerta.Contenido ?? "Sin descripción")</small>
                                                    <br />
                                                    <small class="text-muted">@(alerta.Created_at?.ToString("dd/MM/yyyy HH:mm") ?? "Fecha desconocida")</small>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="text-center text-muted mb-0">No hay alertas activas</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </nav>
    }
    @RenderBody()
    
    @RenderSection("Scripts", required: false)

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alertItems = document.querySelectorAll(".alerta-item");
            alertItems.forEach(item => {
                item.addEventListener("click", function () {
                    const id = this.getAttribute("data-id");
                    const alertaId = this.getAttribute("data-alerta-id");
                    
                    if (alertaId) {
                        fetch('/Pacientes/MarcarAlertaVista', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ idAlerta: parseInt(alertaId) })
                        });
                    }
                    
                    const modalElement = document.getElementById('notifModal');
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                    
                    setTimeout(() => {
                        const backdrop = document.querySelector('.modal-backdrop');
                        if (backdrop) {
                            backdrop.remove();
                        }
                        document.body.classList.remove('modal-open');
                        document.body.style.overflow = '';
                        document.body.style.paddingRight = '';
                    }, 300);
                    
                    if (typeof showPatientDetails === 'function') {
                        setTimeout(() => {
                            showPatientDetails(parseInt(id));
                        }, 350);
                    } else {
                        window.location.href = `/Pacientes/Details/${id}`;
                    }
                });
            });
        });
    </script>
</body>
</html>
