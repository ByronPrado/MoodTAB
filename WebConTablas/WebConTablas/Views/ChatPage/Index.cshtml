@{
    ViewData["Title"] = "Chatbot";
}

<h3 class="mt-3">🤖 Chatbot</h3>
<div id="chat-box" style="border:1px solid #ccc; padding:10px; height:400px; overflow-y:auto; background:#f9f9f9; text-align:left;"></div>

<div class="mt-2 d-flex">
    <input id="userInput" type="text" class="form-control" placeholder="Escribe un mensaje..." />
    <button class="btn btn-primary ms-2" onclick="sendMessage()">Enviar</button>
</div>

<hr />
<h4>🛑 Palabras sensibles detectadas (debug)</h4>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Palabra</th>
        </tr>
    </thead>
    <tbody id="sensitive-words">
    </tbody>
</table>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
async function sendMessage() {
    const input = document.getElementById("userInput");
    const chatBox = document.getElementById("chat-box");
    const sensitiveTable = document.getElementById("sensitive-words");

    const userMessage = input.value;
    if (!userMessage.trim()) return;

    chatBox.innerHTML += `<div><b>👤 Tú:</b> ${marked.parse(userMessage)}</div>`;
    input.value = "";

    // Llamada al ChatController
    const response = await fetch("/chat/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: userMessage })
    });

    const data = await response.json();

    // Respuesta del bot
    chatBox.innerHTML += `<div><b>🤖 Bot:</b> ${marked.parse(data.reply)}</div>`;
    chatBox.scrollTop = chatBox.scrollHeight;

    // 🔹 Actualizar tabla con palabras sensibles
    sensitiveTable.innerHTML = "";
    if (data.sensitiveWords && data.sensitiveWords.length > 0) {
        data.sensitiveWords.forEach(w => {
            sensitiveTable.innerHTML += `<tr><td>${w}</td></tr>`;
        });
    }
}
</script>
}
